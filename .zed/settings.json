{
  "languages": {
    "Markdown": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "TOML": {
      "formatter": "prettier",
      "format_on_save": "off",
    },
    "YAML": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "JSON": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "formatter": "prettier",
    },
    "JSONC": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "formatter": "prettier",
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "CSS": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "Rust": {
      "prettier": {
        "allowed": false,
      },
      "formatter": {
        "external": {
          "command": "rustfmt",
          "arguments": ["--edition", "2021", "--emit", "stdout", "--quiet"],
        },
      },
      "tasks": {
        "variables": {
          "RUST_DEFAULT_PACKAGE_RUN": "zed",
        },
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "enabled": false,
      "initialization_options": {
        "procMacro": {
          "processes": 4,
        },
      },
    },
    // zed-kask: enable language servers for the file types the kask
    // codebase relies on (templates, manifests, configs, scripts).
    "bash-language-server": {
      "enabled": true,
    },
    "yaml-language-server": {
      "enabled": true,
    },
    "taplo": {
      "enabled": true,
    },
  },
  // zed-kask: auto-install extensions that provide language support
  // (tree-sitter grammars + LSPs) for file types used throughout the
  // kask registry and configs. bash and yaml LSPs are built-in.
  "auto_install_extensions": {
    "html": true,
    "toml": true,
    "csv": true,
    "jinja": true,
  },
  "file_types": {
    "Dockerfile": ["Dockerfile*[!dockerignore]"],
    "JSONC": ["**/assets/**/*.json", "renovate.json"],
    "Git Ignore": ["dockerignore"],
    // zed-kask: map kask template extensions to Jinja so the jinja
    // extension's grammar and tooling apply by default.
    "Jinja": ["**/*.j2", "**/*.jinja", "**/*.jinja2"],
  },
  "hard_tabs": false,
  "formatter": "auto",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "file_scan_exclusions": [
    "crates/agent/src/tools/evals/fixtures",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "read_only_files": ["**/.rustup/**", "**/.cargo/registry/**", "**/.cargo/git/**", "target/**/*.rs", "**/*.lock"],

}
