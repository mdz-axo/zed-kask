name: zed-kask
title: Zed-Kask
base: core24
version: "$RELEASE_VERSION"
summary: Zed editor with the Kask agentic AI tools in-process
description: |
  Zed-Kask is a fork of Zed, the high-performance, multiplayer code editor built
  in Rust with a GPU-accelerated renderer, with the Kask agentic AI tools —
  skills, MCP servers, regulation nervous system, and sovereign memory —
  integrated as native editor surfaces. One clone, one build, one CI.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/mdz-axo/zed-kask
source-code: https://github.com/mdz-axo/zed-kask
issues: https://github.com/mdz-axo/zed-kask/issues
contact: https://github.com/mdz-axo/zed-kask/issues

# zed-kask publishes a weekly build every Monday at 08:00 UTC (see
# .github/workflows/kask-release.yml). The `weekly` tag is force-moved to the
# current main commit and the GitHub Release assets are refreshed. Point
# `source:` at the weekly tag so `snapcraft` always pulls the latest weekly
# build; override $RELEASE_VERSION (and $RELEASE_TAG) at build time to pin a
# specific release.
parts:
  zed-kask:
    plugin: dump
    source: "https://github.com/mdz-axo/zed-kask/releases/download/$RELEASE_TAG/zed-kask-x86_64-unknown-linux-gnu.tar.gz"

    organize:
      # The zed-kask release archive has a flat layout: zed-kask + hkask-mcp-*
      # binaries at the archive root. Map the editor binary into the snap's
      # usr/bin so the desktop entry's Exec resolves. The MCP server binaries
      # stay at the archive root (snap classic confinement puts the snap's
      # root on PATH).
      zed-kask: usr/bin/zed-kask

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  zed-kask:
    command: usr/bin/zed-kask
    common-id: dev.zed-kask.Zed-Kask
    environment:
      ZED_BUNDLE_TYPE: snap
