#!/usr/bin/env bash

set -euo pipefail

if [[ ! " $* " == *" -p "* && ! " $* " == *" --package "* ]]; then
    set -- "$@" --workspace
fi

set -x
# --all-features enables every feature in every workspace crate. This is
# correct for the Linux-only clippy CI job: platform-specific features
# (gpui_web/multithreaded for wasm, gpui_macos/runtime_shaders, vim/neovim)
# do not fire on Linux. If a macOS/Windows clippy job is added, revisit this
# flag — some features may pull platform-specific deps that fail to build.
#
# zed-kask: cap concurrent rustc/clippy-driver invocations. Uncapped, cargo
# spawns one per core and each release-profile crate pins its core for minutes
# (codegen-units=1 + thin LTO), starving local machines. The cap is
# min(nproc, 8), so CI runners (typically ≤8 cores) are unaffected. Override
# with HKASK_BUILD_JOBS.
JOBS="${HKASK_BUILD_JOBS:-$(( $(nproc) < 8 ? $(nproc) : 8 ))}"
"${CARGO:-cargo}" clippy "$@" --jobs "$JOBS" --release --all-targets --all-features -- --deny warnings

# If local, run other checks if we have the tools installed.
if [[ -z "${GITHUB_ACTIONS+x}" ]]; then
    which cargo-machete >/dev/null 2>&1 || exit 0
    # Scoped to kask/: upstream crates/ produce machete false positives
    # (macro/feature-activated usage) that upstream CI owns, not us.
    (cd kask && cargo machete)

    which typos >/dev/null 2>&1 || exit 0
    typos --config typos.toml

    which buf >/dev/null 2>&1 || exit 0
    buf lint crates/proto/proto
    buf format --diff --exit-code crates/proto/proto
fi
