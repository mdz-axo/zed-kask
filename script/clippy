#!/usr/bin/env bash

set -euo pipefail

if [[ ! " $* " == *" -p "* && ! " $* " == *" --package "* ]]; then
    set -- "$@" --workspace
    # zed-kask: exclude remote_server from the workspace clippy. Its
    # `debug-embed` feature (upstream, needed for cross-compilation asset
    # embedding) is the sole request that turns on rust-embed's
    # debug-embed across the graph; under --all-features that feature
    # unifies into the single host proc-macro rust-embed-impl, which then
    # emits `Filenames::Embedded` ungated in every derive — while the
    # target rust-embed instance crates like settings link (dev profile,
    # no debug-embed in its feature world) lacks that variant (E0599).
    # Upstream never sees this because its clippy runs --release, where
    # `not(debug_assertions)` makes the variant exist unconditionally;
    # the D52 dev-profile default exposed it. Excluding the crate removes
    # the divergent feature request (one rust-embed feature world) without
    # touching upstream code or breaking cross-compilation. remote_server
    # is upstream-owned (kask never modifies it) — its lint health is
    # upstream CI's, like the machete scoping below.
    set -- "$@" --exclude remote_server
fi

set -x
# --all-features enables every feature in the selected packages. This is
# correct for the Linux-only clippy CI job: platform-specific features
# (gpui_web/multithreaded for wasm, gpui_macos/runtime_shaders, vim/neovim)
# do not fire on Linux. If a macOS/Windows clippy job is added, revisit this
# flag — some features may pull platform-specific deps that fail to build.
#
# zed-kask: bound concurrent rustc/clippy-driver work so a large dependency
# graph cannot saturate the host. Cap at min(nproc, 16); override with
# HKASK_BUILD_JOBS.
JOBS="${HKASK_BUILD_JOBS:-$(( $(nproc) < 16 ? $(nproc) : 16 ))}"

# zed-kask: reuse compiled deps across clippy runs via sccache, when the
# binary is present (script/setup-sccache installs it to
# ~/.local/lib/kask-sccache/, outside target/ so cargo clean cannot delete
# the wrapper). A missing binary must not break the lint run, but it must
# be visible.
if [[ -x "${HKASK_SCCACHE_DIR:-$HOME/.local/lib/kask-sccache}/sccache" ]]; then
    export RUSTC_WRAPPER="${HKASK_SCCACHE_DIR:-$HOME/.local/lib/kask-sccache}/sccache"
    echo "sccache enabled: $RUSTC_WRAPPER"
else
    echo "warning: sccache not found at ${HKASK_SCCACHE_DIR:-$HOME/.local/lib/kask-sccache}/sccache — running uncached (bash script/setup-sccache to enable)" >&2
fi

# zed-kask: D52 — use Cargo's dev default for the normal feedback loop.
# Forcing release here builds a separate dependency graph from dev checks;
# callers can still request --release or --profile explicitly via "$@".
"${CARGO:-cargo}" clippy "$@" --jobs "$JOBS" --all-targets --all-features -- --deny warnings

# If local, run other checks if we have the tools installed.
if [[ -z "${GITHUB_ACTIONS+x}" ]]; then
    which cargo-machete >/dev/null 2>&1 || exit 0
    # Scoped to kask/: upstream crates/ produce machete false positives
    # (macro/feature-activated usage) that upstream CI owns, not us.
    (cd kask && cargo machete)

    which typos >/dev/null 2>&1 || exit 0
    typos --config typos.toml

    which buf >/dev/null 2>&1 || exit 0
    buf lint crates/proto/proto
    buf format --diff --exit-code crates/proto/proto
fi
