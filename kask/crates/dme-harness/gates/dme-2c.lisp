;; dme-2c gate of the direct-model-edit skill. `in` = output of dme-measure.jq over dme-harness files.
;; Returns a verdict symbol or a list headed by one. Built not to raise on a malformed `in`:
;; treat an evaluator error as a refusal and report it. Call with max_steps 2000000.
(begin
 (define objp (lambda (v) (and (listp v) (not (is_null v)) (listp (car v)) (= (length (car v)) 2) (stringp (car (car v))))))
 (define fld (lambda (k o) (if (listp o) (assoc k o) (list))))
 (define num (lambda (v) (and (numberp v) (<= v 1000000000) (>= v (- 0 1000000000)))))
 (define nn (lambda (v) (and (num v) (>= v 0) (eq (- v v) 0))))
 (define zero (lambda (v) (and (numberp v) (= v 0))))
 (define one (lambda (x) (and (listp x) (= (length x) 1))))
 (define nonempty (lambda (x) (and (listp x) (not (is_null x)))))
 (define names (lambda (v) (if (nonempty v) v (list))))
 (define cnt (lambda (r k) (fld k (fld "counts" r))))
 (define counts-ok (lambda (r) (and (nn (cnt r "hit_limit")) (nn (cnt r "wrong_complete")) (nn (cnt r "correct_complete")) (= (+ (cnt r "hit_limit") (cnt r "wrong_complete") (cnt r "correct_complete")) (fld "answers" r)))))
 (define run-ok (lambda (r) (cond
   ((not (objp r)) (quote measurement-missing))
   ((not (and (nn (fld "answers" r)) (> (fld "answers" r) 0))) (quote rows-missing))
   ((not (zero (fld "malformed" r))) (quote rows-malformed))
   ((not (zero (fld "repeated_ids" r))) (quote rows-repeat-a-problem))
   ((not (eq (fld "summary_agrees" r) true)) (quote rows-disagree-with-harness-summary))
   ((not (and (numberp (fld "fact_sets" r)) (= (fld "fact_sets" r) 1) (is_null (fld "differs_within" r)))) (list (quote run-facts-mixed-within-a-run) (names (fld "differs_within" r))))
   ((not (and (zero (fld "facts_missing_count" r)) (is_null (fld "facts_missing" r)))) (list (quote run-facts-incomplete) (names (fld "facts_missing" r))))
   ((not (and (one (fld "model_files" r)) (stringp (car (fld "model_files" r))))) (quote model-file-hash-missing-or-mixed))
   ((not (counts-ok r)) (quote measurement-inconsistent))
   (t true))))
 (define cell (lambda (p k) (fld k (fld "table" p))))
 (define cells-ok (lambda (p ks) (or (is_null ks) (and (nn (cell p (car ks))) (cells-ok p (cdr ks))))))
 (define half-ok (lambda (p b) (cond
   ((not (and (zero (fld "seed_mismatch" p)) (zero (fld "gold_mismatch" p)) (zero (fld "prompt_mismatch" p)) (numberp (fld "paired" p)) (= (fld "paired" p) (fld "answers" b)))) (quote rows-not-paired))
   ((not (cells-ok p (list "hh" "hw" "hc" "wh" "ww" "wc" "ch" "cw" "cc"))) (quote measurement-inconsistent))
   ((not (and (= (+ (cell p "hh") (cell p "wh") (cell p "ch")) (cnt b "hit_limit")) (= (+ (cell p "hw") (cell p "ww") (cell p "cw")) (cnt b "wrong_complete")) (= (+ (cell p "hc") (cell p "wc") (cell p "cc")) (cnt b "correct_complete")))) (quote measurement-inconsistent))
   (t true))))
 (define pair-ok (lambda (p a b) (let ((h (half-ok p b))) (cond
   ((not (eq h true)) h)
   ((not (= (fld "paired" p) (fld "answers" a))) (quote rows-not-paired))
   ((not (and (= (+ (cell p "hh") (cell p "hw") (cell p "hc")) (cnt a "hit_limit")) (= (+ (cell p "wh") (cell p "ww") (cell p "wc")) (cnt a "wrong_complete")) (= (+ (cell p "ch") (cell p "cw") (cell p "cc")) (cnt a "correct_complete")))) (quote measurement-inconsistent))
   (t true)))))
 (define up (lambda (p) (+ (cell p "hc") (cell p "wc"))))
 (define down (lambda (p) (+ (cell p "ch") (cell p "cw"))))
 (define mixed (lambda (r) (and (numberp (fld "fact_sets" r)) (> (fld "fact_sets" r) 1))))
 (define arm-ok (lambda (b e) (if (or (mixed b) (mixed e)) (list (quote run-facts-mixed-within-a-run) (names (fld "differs_from_base" e)) (names (fld "differs_within" b)) (names (fld "differs_within" e)))
  (let ((rb (run-ok b))) (if (not (eq rb true)) (list (quote base-run) rb) (let ((re (run-ok e))) (cond
   ((not (eq re true)) (list (quote edited-run) re))
   ((not (and (zero (fld "differs_count" e)) (is_null (fld "differs_from_base" e)))) (list (quote runs-differ-beyond-the-model-file) (names (fld "differs_from_base" e))))
   ((string= (car (fld "model_files" b)) (car (fld "model_files" e))) (quote edited-rows-carry-the-base-model-file))
   ((not (and (numberp (fld "receipt_count" e)) (> (fld "receipt_count" e) 0))) (quote edit-receipts-missing))
   ((not (and (stringp (fld "chain_end" e)) (string= (fld "chain_end" e) (car (fld "model_files" e))))) (quote receipts-do-not-link-base-to-edited))
   ((not (nn (fld "collateral" e))) (quote collateral-change-unrecorded))
   ((> (fld "collateral" e) 0) (list (quote collateral-change-reported) (fld "collateral" e)))
   (t (pair-ok (fld "vs_base" e) b e)))))))))
 (define hp (lambda (n) (if (<= n 0) 1.0 (* 0.5 (hp (- n 1))))))
 (define tl (lambda (j k n d acc) (if (> j k) acc (tl (+ j 1) k n (/ (* d (- n j)) (+ j 1)) (+ acc d)))))
 (define sig (lambda (b c) (cond ((= (+ b c) 0) false) ((> (+ b c) 100) (>= (* (- (abs (- b c)) 1) (- (abs (- b c)) 1)) (* 3.8415 (+ b c)))) (t (< (* 2 (tl 0 (min b c) (+ b c) (hp (+ b c)) 0.0)) 0.05)))))
 (define est (lambda (b c n) (if (and (sig b c) (> (* 100 (abs (- b c))) n)) (if (> b c) 1 (- 0 1)) 0)))
 (define near (lambda (a b) (and (num a) (num b) (<= (abs (- a b)) (* 0.01 (max (abs a) (abs b)))))))
 (define like-ok (lambda (k) (and (listp k) (eq (fld "count_equal" k) true) (zero (fld "site_mismatches" k)) (zero (fld "ratios_unmeasured" k)) (num (fld "alpha_ratio_min" k)) (> (fld "alpha_ratio_min" k) 0) (num (fld "alpha_ratio_max" k)) (num (fld "size_ratio_min" k)) (num (fld "size_ratio_max" k)))))
 (define ctl-ok (lambda (k) (cond
   ((not (zero (fld "directions_unrecorded" k))) (quote direction-not-recorded-in-receipt))
   ((not (and (like-ok k) (eq (fld "first_source" k) "file") (eq (fld "second_source" k) "seeded") (near (fld "alpha_ratio_min" k) 1) (near (fld "alpha_ratio_max" k) 1))) (quote control-edit-not-comparable))
   ((not (and (num (fld "second_offcentre_max" k)) (<= (fld "second_offcentre_max" k) 4))) (quote control-direction-not-centred))
   ((not (and (near (fld "size_ratio_min" k) 1) (near (fld "size_ratio_max" k) 1))) (quote control-not-norm-matched))
   (t true))))
 (define drop (lambda (p) (- (+ (cell p "hw") (cell p "hc")) (+ (cell p "wh") (cell p "ch")))))
 (define spec-judge (lambda (pt pc pd n)
   (let ((nt (- (up pt) (down pt))) (nr (- (up pc) (down pc))) (tt (drop pt)) (tc (drop pc)))
     (list (cond ((not (= (est (up pt) (down pt) n) 1)) (quote targeted-gain-not-established))
                 ((>= (abs nr) (* 0.25 nt)) (quote control-change-at-least-a-quarter-of-targeted))
                 ((and (> tt 0) (>= tc (* 0.25 tt))) (quote control-unblocks-at-least-a-quarter-as-much))
                 ((not (= (est (up pd) (down pd) n) 1)) (quote specificity-not-established))
                 ((not (= (est (up pc) (down pc) n) 0)) (quote control-change-is-itself-established))
                 (t (quote direction-specific)))
           (list)
           (list (list "answers" n) (list "targeted_net" nt) (list "control_net" nr) (list "targeted_over_control_net" (- (up pd) (down pd))) (list "targeted_truncation_drop" tt) (list "control_truncation_drop" tc))))))
 (cond ((not (objp in)) (quote inputs-not-an-object)) ((not (eq (fld "gate" in) "dme-2c")) (quote env-built-for-another-gate)) (t
  (let ((b (fld "base" in)) (tg (fld "targeted" in)) (ct (fld "control" in)))
   (let ((at (arm-ok b tg)))
    (cond ((not (eq at true)) (list (quote targeted-arm) at))
          ((not (and (objp ct) (nn (fld "answers" ct)) (> (fld "answers" ct) 0))) (quote control-rows-missing))
          (t (let ((ac (arm-ok b ct)))
               (cond ((not (eq ac true)) (list (quote control-arm) ac))
                     ((not (eq (ctl-ok (fld "like_targeted" ct)) true)) (ctl-ok (fld "like_targeted" ct)))
                     ((not (eq (pair-ok (fld "to_targeted" ct) ct tg) true)) (list (quote control-to-targeted) (pair-ok (fld "to_targeted" ct) ct tg)))
                     (t (spec-judge (fld "vs_base" tg) (fld "vs_base" ct) (fld "to_targeted" ct) (fld "answers" b)))))))))))
)
