;; dme-0 gate of the direct-model-edit skill. `in` = output of dme-measure.jq over dme-harness files.
;; Returns a verdict symbol or a list headed by one. Built not to raise on a malformed `in`:
;; treat an evaluator error as a refusal and report it. Call with max_steps 2000000.
(begin
 (define objp (lambda (v) (and (listp v) (not (is_null v)) (listp (car v)) (= (length (car v)) 2) (stringp (car (car v))))))
 (define fld (lambda (k o) (if (listp o) (assoc k o) (list))))
 (define num (lambda (v) (and (numberp v) (<= v 1000000000) (>= v (- 0 1000000000)))))
 (define nn (lambda (v) (and (num v) (>= v 0) (eq (- v v) 0))))
 (define zero (lambda (v) (and (numberp v) (= v 0))))
 (define one (lambda (x) (and (listp x) (= (length x) 1))))
 (define nonempty (lambda (x) (and (listp x) (not (is_null x)))))
 (define names (lambda (v) (if (nonempty v) v (list))))
 (define cnt (lambda (r k) (fld k (fld "counts" r))))
 (define counts-ok (lambda (r) (and (nn (cnt r "hit_limit")) (nn (cnt r "wrong_complete")) (nn (cnt r "correct_complete")) (= (+ (cnt r "hit_limit") (cnt r "wrong_complete") (cnt r "correct_complete")) (fld "answers" r)))))
 (define run-ok (lambda (r) (cond
   ((not (objp r)) (quote measurement-missing))
   ((not (and (nn (fld "answers" r)) (> (fld "answers" r) 0))) (quote rows-missing))
   ((not (zero (fld "malformed" r))) (quote rows-malformed))
   ((not (zero (fld "repeated_ids" r))) (quote rows-repeat-a-problem))
   ((not (eq (fld "summary_agrees" r) true)) (quote rows-disagree-with-harness-summary))
   ((not (and (numberp (fld "fact_sets" r)) (= (fld "fact_sets" r) 1) (is_null (fld "differs_within" r)))) (list (quote run-facts-mixed-within-a-run) (names (fld "differs_within" r))))
   ((not (and (zero (fld "facts_missing_count" r)) (is_null (fld "facts_missing" r)))) (list (quote run-facts-incomplete) (names (fld "facts_missing" r))))
   ((not (and (one (fld "model_files" r)) (stringp (car (fld "model_files" r))))) (quote model-file-hash-missing-or-mixed))
   ((not (counts-ok r)) (quote measurement-inconsistent))
   (t true))))
 (define close6 (lambda (a b) (<= (abs (- a b)) (* 0.000001 (max 1 (abs a) (abs b))))))
 (define boolp (lambda (v) (or (eq v true) (eq v false))))
 (define sampling (list "temperature" "top_p" "top_k" "min_p" "presence_penalty" "repetition_penalty"))
 (define nums (list "temperature" "top_p" "top_k" "min_p" "presence_penalty" "repetition_penalty" "cap" "penalty_last_n"))
 (define bad-run (lambda (ks r) (cond ((is_null ks) (list)) ((num (fld (car ks) r)) (bad-run (cdr ks) r)) (t (cons (car ks) (bad-run (cdr ks) r))))))
 (define bad-card (lambda (ks c) (cond ((is_null ks) (list)) ((or (is_null (fld (car ks) c)) (num (fld (car ks) c))) (bad-card (cdr ks) c)) (t (cons (car ks) (bad-card (cdr ks) c))))))
 (define silent (lambda (ks c) (cond ((is_null ks) (list)) ((is_null (fld (car ks) c)) (cons (car ks) (silent (cdr ks) c))) (t (silent (cdr ks) c)))))
 (define moved (lambda (ks r c) (cond ((is_null ks) (list)) ((or (is_null (fld (car ks) c)) (close6 (fld (car ks) r) (fld (car ks) c))) (moved (cdr ks) r c)) (t (cons (car ks) (moved (cdr ks) r c))))))
 (define modeless (lambda (c) (is_null (fld "enable_thinking" c))))
 (define compare (lambda (r c)
   (let ((rb (append (if (boolp (fld "enable_thinking" r)) (list) (list "enable_thinking")) (bad-run nums r)))
         (cb (append (if (or (modeless c) (boolp (fld "enable_thinking" c))) (list) (list "enable_thinking")) (bad-card nums c))))
     (cond ((not (is_null rb)) (list (quote run-setting-missing-or-mistyped) rb))
           ((not (is_null cb)) (list (quote card-row-value-ambiguous-or-mistyped) cb))
           ((= (length (silent sampling c)) (length sampling)) (quote card-quote-states-no-sampling-setting))
           (t (let ((d (append (if (or (modeless c) (eq (fld "enable_thinking" r) (fld "enable_thinking" c))) (list) (list "enable_thinking")) (moved nums r c)))
                    (u (append (if (modeless c) (list "enable_thinking") (list)) (silent nums c)))
                    (m (cond ((not (boolp (fld "default_enable_thinking" c))) (list "card-default-mode-not-stated")) ((eq (fld "default_enable_thinking" c) (fld "enable_thinking" r)) (list)) (t (list "mode-is-not-the-card-default")))))
                (list (cond ((not (is_null d)) (quote settings-differ-from-card-row)) ((is_null (silent sampling c)) (quote settings-match-card-row)) (t (quote settings-match-on-stated-settings-only))) (fld "row" c) d u m)))))))
 (define text (lambda (v) (and (stringp v) (not (string= v "")) (not (string= v "mistyped")))))
 (cond ((not (objp in)) (quote inputs-not-an-object)) ((not (eq (fld "gate" in) "dme-0")) (quote env-built-for-another-gate)) (t
  (let ((r (fld "run" in)) (q (fld "quoted" in)))
   (let ((ok (run-ok r)) (c (fld "card_row" r)))
    (cond ((not (eq ok true)) ok)
          ((not (objp (fld "settings" r))) (quote run-settings-missing))
          ((not (objp c)) (quote card-row-missing))
          ((not (and (text (fld "row" c)) (text (fld "source_quote" c)))) (quote card-row-not-named-or-unquoted))
          ((not (eq (fld "quote_in_card" in) true)) (quote card-row-quote-not-found-in-card))
          (t (compare (fld "settings" r) (append (if (listp q) q (list)) c))))))))
)
