{# goal: Compute status, forecast_level_composite, forecaster_level_composite, red_flag_screen, green_flag_endorsement, failing_marker_summary and overconfidence_bias from per_rationale_scores. #}
[inference]
contract:
  input:
    per_rationale_scores: array
  output:
    status: string
    incomplete_rationales: array
    forecast_level_composite: array
    forecaster_level_composite: array
    red_flag_screen: array
    green_flag_endorsement: array
    failing_marker_summary: array
    overconfidence_bias: number|null
---
{#- Computed render: the output is the aggregate itself, a JSON document. No
    model fills anything in. Each record of per_rationale_scores is one
    market_score_rationale result plus its corpus metadata:
    {rationale_index, question, forecaster_id?, composite_score,
     scores: [{id, score}], missing_eqms?}.

    Completeness: a record is incomplete when the tool reported missing_eqms,
    when its score ids are not exactly the predictive twelve, when a score is
    outside 0-2, or when composite_score is not sum(helps) - sum(hurts). One
    incomplete record makes the batch incomplete and no numeric aggregate is
    emitted: a zero-filled marker is not an observed low score.

    EQM-2, the asymmetric decision rule: red_flag_screen is two or more hurts
    markers at score 2 (the strong signal); green_flag_endorsement is
    composite >= 4 with no hurts marker above 0 (the weak signal).
    failing_markers are listed in priority order: hurts at 2, hurts at 1,
    helps at 0, helps at 1. overconfidence_bias is
    (extreme_confidence + forecast_rationale_misalign - statistical_reasoning
     - best_practices) summed over rationales, divided by 2n; range [-2, 2]. -#}
{%- from "eqm/predictive-markers.j2" import marker_specs -%}
{%- set specs = marker_specs -%}
{%- set expected = specs | map(attribute="id") | list -%}
{%- set ns = namespace(rows=[], incomplete=[], red=[], green=[], summary=[]) -%}
{%- for r in per_rationale_scores -%}
  {%- set ids = r.scores | map(attribute="id") | list -%}
  {%- set absent_ids = expected | reject("in", ids) | list -%}
  {%- set unknown_ids = ids | reject("in", expected) | list -%}
  {%- set duplicated = (ids | unique(case_sensitive=true) | list | length) != (ids | length) -%}
  {%- set out_of_range = r.scores | rejectattr("score", "in", [0, 1, 2]) | map(attribute="id") | list -%}
  {%- set tool_missing = r.missing_eqms | default([]) -%}
  {%- if absent_ids or unknown_ids or duplicated or out_of_range or tool_missing -%}
    {%- set ns.incomplete = ns.incomplete + [{"rationale_index": r.rationale_index, "missing_eqms": tool_missing, "absent_ids": absent_ids, "unknown_ids": unknown_ids, "duplicate_ids": duplicated, "out_of_range_ids": out_of_range, "composite_mismatch": false}] -%}
  {%- else -%}
    {%- set mk = namespace(rows=[]) -%}
    {%- for s in specs -%}
      {%- set score = r.scores | selectattr("id", "eq", s.id) | map(attribute="score") | first -%}
      {%- set goal_score = 2 if s.direction == "helps" else 0 -%}
      {%- set mk.rows = mk.rows + [{"id": s.id, "name": s.name, "direction": s.direction, "current_score": score, "target_score": goal_score, "gap": (goal_score - score) | abs, "description": s.description}] -%}
    {%- endfor -%}
    {%- set hurts = mk.rows | selectattr("direction", "eq", "hurts") | list -%}
    {%- set helps = mk.rows | selectattr("direction", "eq", "helps") | list -%}
    {%- set composite = (helps | map(attribute="current_score") | sum) - (hurts | map(attribute="current_score") | sum) -%}
    {%- if composite != r.composite_score -%}
      {%- set ns.incomplete = ns.incomplete + [{"rationale_index": r.rationale_index, "missing_eqms": [], "absent_ids": [], "unknown_ids": [], "duplicate_ids": false, "out_of_range_ids": [], "composite_mismatch": true}] -%}
    {%- else -%}
      {%- set red_flags = hurts | selectattr("current_score", "eq", 2) | map(attribute="name") | list -%}
      {%- set green_flags = helps | selectattr("current_score", "eq", 2) | map(attribute="name") | list -%}
      {%- set hurts_above_0 = hurts | selectattr("current_score", "gt", 0) | list | length -%}
      {%- set failing = (hurts | selectattr("current_score", "eq", 2) | list) + (hurts | selectattr("current_score", "eq", 1) | list) + (helps | selectattr("current_score", "eq", 0) | list) + (helps | selectattr("current_score", "eq", 1) | list) -%}
      {%- set bias = (mk.rows | selectattr("id", "eq", "extreme_confidence") | map(attribute="current_score") | first) + (mk.rows | selectattr("id", "eq", "forecast_rationale_misalign") | map(attribute="current_score") | first) - (mk.rows | selectattr("id", "eq", "statistical_reasoning") | map(attribute="current_score") | first) - (mk.rows | selectattr("id", "eq", "best_practices") | map(attribute="current_score") | first) -%}
      {%- set who = r.forecaster_id | default(none) -%}
      {%- set ns.rows = ns.rows + [{"rationale_index": r.rationale_index, "question": r.question, "forecaster_id": who, "composite_score": composite, "red_flag_count": red_flags | length, "green_flag_count": green_flags | length, "bias_numerator": bias}] -%}
      {%- set ns.summary = ns.summary + [{"rationale_index": r.rationale_index, "question": r.question, "forecaster_id": who, "current_composite": composite, "failing_markers": failing}] -%}
      {%- if (red_flags | length) >= 2 -%}
        {%- set ns.red = ns.red + [{"rationale_index": r.rationale_index, "question": r.question, "forecaster_id": who, "red_flags": red_flags, "severity": "high"}] -%}
      {%- endif -%}
      {%- if composite >= 4 and hurts_above_0 == 0 -%}
        {%- set ns.green = ns.green + [{"rationale_index": r.rationale_index, "question": r.question, "forecaster_id": who, "green_flags": green_flags, "confidence": "weak", "note": "High composite with no red flags is a weak positive endorsement, not a strong-rationale claim."}] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- set rows = ns.rows -%}
{%- set n = rows | length -%}
{%- if ns.incomplete or n == 0 -%}
{{ {"status": "incomplete" if ns.incomplete else "unassessed", "incomplete_rationales": ns.incomplete, "forecast_level_composite": [], "forecaster_level_composite": [], "red_flag_screen": [], "green_flag_endorsement": [], "failing_marker_summary": [], "overconfidence_bias": none} | tojson(indent=2) }}
{%- else -%}
  {%- set out = namespace(by_question=[], by_forecaster=[]) -%}
  {%- for g in rows | groupby("question", case_sensitive=true) -%}
    {%- set k = g.list | length -%}
    {%- set out.by_question = out.by_question + [{"question": g.grouper, "mean_composite": ((g.list | map(attribute="composite_score") | sum) / k) | round(4), "red_flag_count": g.list | map(attribute="red_flag_count") | sum, "green_flag_count": g.list | map(attribute="green_flag_count") | sum, "rationale_count": k}] -%}
  {%- endfor -%}
  {%- for g in rows | selectattr("forecaster_id") | groupby("forecaster_id", case_sensitive=true) -%}
    {%- set k = g.list | length -%}
    {%- set out.by_forecaster = out.by_forecaster + [{"forecaster_id": g.grouper, "mean_composite": ((g.list | map(attribute="composite_score") | sum) / k) | round(4), "red_flag_frequency": ((g.list | map(attribute="red_flag_count") | sum) / k) | round(4), "green_flag_frequency": ((g.list | map(attribute="green_flag_count") | sum) / k) | round(4), "rationale_count": k}] -%}
  {%- endfor -%}
{{ {"status": "complete", "incomplete_rationales": [], "forecast_level_composite": out.by_question, "forecaster_level_composite": out.by_forecaster, "red_flag_screen": ns.red, "green_flag_endorsement": ns.green, "failing_marker_summary": ns.summary, "overconfidence_bias": ((rows | map(attribute="bias_numerator") | sum) / (2 * n)) | round(4)} | tojson(indent=2) }}
{%- endif -%}
