{# Curator Metacognition — Kata Directives #}
{# Rendered when capability gaps are detected in bot reports. #}
{# Produces an array of Kata coaching directives for bots with gaps. #}
{
  "kata_directives": [
    {%- for bot in bot_reports | selectattr('capability_gap', 'defined') | list %}
    {
      "bot_id": "{{ bot.bot_id }}",
      "kata_type": "{{ 'improvement' if bot.capability_gap.severity == 'high' else 'coaching' if bot.capability_gap.severity == 'medium' else 'starter' }}",
      "target_condition": "Close capability gap: {{ bot.capability_gap.description | default('unspecified') }}",
      "current_condition": "{{ bot.capability_gap.current_state | default('unknown') }}",
      "obstacle": "{{ bot.capability_gap.obstacle | default('not yet diagnosed') }}",
      "next_step": "{{ bot.capability_gap.suggested_experiment | default('run diagnostic') }}"
    }{%- if not loop.last %},{% endif %}
    {%- endfor %}
  ],
  "recommended_kata_type": "{{ 'improvement' if system_health == 'critical' else 'coaching' if system_health == 'degraded' else 'starter' }}",
  "target_bots": [
    {%- for bot in bot_reports | selectattr('capability_gap', 'defined') | list %}
    "{{ bot.bot_id }}"{% if not loop.last %}, {% endif %}
    {%- endfor %}
  ]
}
