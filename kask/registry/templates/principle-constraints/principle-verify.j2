[inference]
template_type: KnowAct
contract:
  input:
    principle:
      type: string
      description: The principle statement (re-checked against current code).
    principle_source:
      type: string
      description: Citation for the principle.
    existing_constraints:
      type: array
      description: 'Previously-derived constraint set to re-check. Each entry
        has: id, assertion, kind, enforced_at, falsifier, status.'
    codebase_root:
      type: string
      default: '.'
  output:
    verification_report:
      type: object
      description: 'Per-constraint drift report: previous_status, current_status,
        drift kind, action_required.'
    stale_constraints:
      type: array
      description: 'Constraints that no longer match the codebase — code moved,
