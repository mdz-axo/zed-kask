template_type: KnowAct
contract:
  input:
    l2_flagged_crates:
      type: array
      description: Crates flagged by L2. L3 reviews ONLY these (the propagation contract).
  output:
    l3_findings:
      type: array
      description: Module-depth findings — each with id, crate, issue, deletion_test_verdict, severity.
    reviewed_crates:
      type: array
