# Convergence formula reference for CFR evolutionary loop
# hKask v0.33.0
#
# The convergence check computes the Pareto-frontier stability metric:
#   metric = hypervolume_delta + (0.05 × new_non_dominated_members)
# Converged when metric ≤ 0.10 and iteration ≥ 2.
#
# This is encoded as a lisp.eval compute step in the process manifest
# (step 8), using infix notation for the weighted sum.

convergence_formula:
  description: "Pareto-frontier stability: hypervolume delta + 0.05 × new non-dominated members"
  lisp_expression: "hypervolume_delta + 0.05 * new_non_dominated"
  variables:
    hypervolume_delta:
      description: "Hypervolume difference between frontier_before and frontier_after"
      source: "step_7_result.frontier_changed"
      type: number
      range: [0.0, 1.0]
    new_non_dominated:
      description: "Count of new non-dominated members not in prior frontier"
      source: "step_7_result.new_non_dominated"
      type: integer
      range: [0, 100]
  threshold: 0.10
  min_iterations: 2
  converged_when: "metric <= threshold AND iteration >= min_iterations"