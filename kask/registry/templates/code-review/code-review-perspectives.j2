{# goal: Multi-axis defect DETECTION across PERFECT-ordered axes × the addyosmani five-axis plus the AI-code annex and cross-layer consistency checks, machine findings folded first, with size-tiered read-only delegation. DETECTION ONLY — no verdicts/severity/confidence. Every raw finding cites file:line + verbatim evidence (no-fiction). #}
[inference]
contract:
  input:
    change_model: object
    focus: array
    focus_axes: array
    critical_paths: array
    machine_checks: object
