{# goal: Multi-axis defect DETECTION across PERFECT-ordered axes × the addyosmani five-axis, with optional delegation. DETECTION ONLY — no verdicts/severity/confidence. Every raw finding cites file:line + verbatim evidence (no-fiction). #}
[inference]
contract:
  input:
    change_model: object
    focus: array
    focus_axes: array
    critical_paths: array
