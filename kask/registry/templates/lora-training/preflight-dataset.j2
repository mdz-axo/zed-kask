{# goal: Render observed dataset_validation dataset_format verdict, detected_format, expected_format, mapping_code and findings for the selected host; expose data_gap when format validation is unavailable. #}
[inference]
contract:
  input:
    host: string
    dataset_validation: object
  output:
    verdict: string
    detected_format: string|null
    expected_format: string|null
    mapping_code: string|null
    findings: array
    host: string
    data_gap: string|null
visibility: Public
---
{# The tool has already read and validated the declared dataset path. This
   render only preserves its values; it does not execute code or training. #}
{% if dataset_validation.dataset_format %}
{
  "verdict": {{ dataset_validation.dataset_format.verdict | tojson }},
  "detected_format": {{ dataset_validation.dataset_format.detected_format | tojson }},
  "expected_format": {{ dataset_validation.dataset_format.expected_format | tojson }},
  "mapping_code": {{ dataset_validation.dataset_format.mapping_code | tojson }},
  "findings": {{ dataset_validation.findings | default([]) | tojson }},
  "host": {{ host | tojson }},
  "data_gap": null
}
{% else %}
{
  "verdict": "undetermined",
  "detected_format": null,
  "expected_format": null,
  "mapping_code": null,
  "findings": {{ dataset_validation.findings | default([]) | tojson }},
  "host": {{ host | tojson }},
  "data_gap": {% if dataset_validation %}"training_validate_config returned no dataset_format for the declared path"{% else %}"dataset validation unavailable: tool not run or failed"{% endif %}
}
{% endif %}

{# A mapping_code, when present, is a runtime proposal for the operator's
   external training harness; it is not executed or written to this repo. #}
