{# Shared Lisp invariant-check forms for reuse across skill manifests.
   # hKask v0.33.0
   #
   # These macros emit Lisp `form:` strings suitable for use in
   # `compute_ref: lisp.eval` steps. They are validated by the
   # `dispatch_lisp_eval_hypothesis_four_invariants` test in
   # kask/crates/hkask-templates/src/compute.rs.
   #
   # Usage in a manifest step:
   #
   #   - ordinal: N
   #     action: compute
   #     compute_ref: lisp.eval
   #     input_mapping:
   #       form: >
   #         {% from "shared/lisp-invariants.j2" import hypothesis_four_invariants %}
   #         {{ hypothesis_four_invariants() }}
   #       env:
   #         step_1_result: "{{ step_1_result }}"
   #
   # Interpreter builtins (v0.33.0+): `append`, `string=`, `concat` are now
   # builtins — no need for recursive `append2` helpers or `assoc`-based
   # string equality tricks. See hkask-lisp/src/hkask_lisp.rs `default_builtins`.
   #}

{# hypothesis_four_invariants: check count (3-7), completeness (prediction +
   falsifier keys present), diversity (>=2 distinct likelihoods), mutual
   exclusivity (no duplicate hypothesis text).
   #}
{% macro hypothesis_four_invariants() %}
(let ((hyps (assoc "hypotheses" step_1_result)))
  (if (is_null hyps)
      (list "no_hypotheses_field")
      (let ((n (length hyps)))
        (begin
          (define count-defects
            (if (< n 3)
                (list "insufficient_count_below_3")
                (if (> n 7)
                    (list "excessive_count_above_7")
                    (list))))
          (define check-completeness
            (lambda (hs acc)
              (if (is_null hs)
                  acc
                  (let ((h (car hs)))
                    (let ((acc2 (if (is_null (assoc "prediction" h))
                                    (cons "missing_prediction" acc)
                                    acc)))
                      (let ((acc3 (if (is_null (assoc "falsifier" h))
                                      (cons "missing_falsifier" acc2)
                                      acc2)))
                        (check-completeness (cdr hs) acc3)))))))
          (define completeness-defects (check-completeness hyps (list)))
          (define check-diversity
            (lambda (hs nh nm nl)
              (if (is_null hs)
                  (let ((distinct (+ (if (> nh 0) 1 0) (if (> nm 0) 1 0) (if (> nl 0) 1 0))))
                    (if (< distinct 2)
                        (list "insufficient_diversity_below_2")
                        (list)))
                  (let ((h (car hs)))
                    (let ((lk (assoc "likelihood" h)))
                      (let ((is-high (string= lk "high")))
                        (let ((is-med (string= lk "medium")))
                          (let ((is-low (string= lk "low")))
                            (check-diversity
                              (cdr hs)
                              (if is-high (+ nh 1) nh)
                              (if is-med (+ nm 1) nm)
                              (if is-low (+ nl 1) nl))))))))))
          (define diversity-defects (check-diversity hyps 0 0 0))
          (define check-duplicates
            (lambda (hs seen)
              (if (is_null hs)
                  (list)
                  (let ((h (car hs)))
                    (let ((hyp-text (assoc "hypothesis" h)))
                      (let ((hyp-str (if (is_null hyp-text) "" hyp-text)))
                        (if (not (is_null (assoc hyp-str seen)))
                            (cons "duplicate_hypothesis" (check-duplicates (cdr hs) seen))
                            (check-duplicates (cdr hs) (cons (list hyp-str true) seen)))))))))
          (define duplicate-defects (check-duplicates hyps (list)))
          (append
            count-defects completeness-defects
            diversity-defects duplicate-defects)))))
{% endmacro %}

{# field_completeness: check that every item in a list has the named keys
   present. Parameters: items_key (the key in step_N_result holding the array),
   required_keys (a Lisp list of string keys to check on each item).
   Returns a list of "missing_<key>" defect strings (via concat).
   #}
{% macro field_completeness(items_key, required_keys) %}
(let ((items (assoc {{ items_key }} step_1_result)))
  (if (is_null items)
      (list "no_items_field")
      (begin
        (define check-one
          (lambda (item keys acc)
            (if (is_null keys)
                acc
                (let ((k (car keys)))
                  (let ((acc2 (if (is_null (assoc k item))
                                  (cons (concat "missing_" k) acc)
                                  acc)))
                    (check-one item (cdr keys) acc2))))))
        (define check-all
          (lambda (items keys acc)
            (if (is_null items)
                acc
                (check-all (cdr items) keys (append acc (check-one (car items) keys (list)))))))
        (check-all items {{ required_keys }} (list)))))
{% endmacro %}

{# count_in_range: check that a list's length is within [min, max].
   Returns a list with a defect string if out of range, empty if in range.
   #}
{% macro count_in_range(items_key, min, max) %}
(let ((items (assoc {{ items_key }} step_1_result)))
  (if (is_null items)
      (list "no_items_field")
      (let ((n (length items)))
        (if (< n {{ min }})
            (list "insufficient_count_below_{{ min }}")
            (if (> n {{ max }})
                (list "excessive_count_above_{{ max }}")
                (list))))))
{% endmacro %}

{# pico_completeness: check that all four PICO keys (population, intervention,
   comparison, outcome) are present and non-null in step_2_result.
   Returns a list of "missing_<key>" defect strings.
   #}
{% macro pico_completeness() %}
(begin
  (define check-key
    (lambda (key)
      (let ((val (assoc key step_2_result)))
        (if (is_null val)
            (list (concat "missing_" key))
            (list)))))
  (append
    (check-key "population")
    (check-key "intervention")
    (check-key "comparison")
    (check-key "outcome")))
{% endmacro %}
