[inference]
contract:
  input:
    exchanges: array
    market_cap_min: number
    market_cap_max: number
    liquidity_min_usd: number
  server_input:
    as_of: string

  output:
    screen_definition: object
visibility: Public
---
{
  "name": "expectations_gap",
  "kind": "expectations_gap",
  "as_of": {{ as_of | tojson }},
  "reporting_currency": "USD",
  "universe": {
    "asset_class": "equity",
    "exchanges": {{ exchanges | tojson }},
    "active_only": true,
    "primary_only": false,
    "security_types": ["common_stock", "adr"]
  },
  "filters": [
    {"field": "market_capitalization", "operator": ">=", "value": {{ market_cap_min }}},
    {"field": "market_capitalization", "operator": "<=", "value": {{ market_cap_max }}}
  ],
  "columns": [
    {"id":"company","label":"Company","source":"company","data_type":"string","unit":null},
    {"id":"primary_ticker","label":"Primary Security","source":"primary_ticker","data_type":"string","unit":null},
    {"id":"actionable_symbol","label":"Eligible Traded Symbol","source":"actionable_symbol","data_type":"string","unit":null},
    {"id":"market_capitalization_usd","label":"Issuer Market Capitalization","source":"market_capitalization_usd","data_type":"number","unit":"USD"},
    {"id":"average_daily_dollar_volume_usd","label":"Average Daily Dollar Volume","source":"average_daily_dollar_volume_usd","data_type":"number","unit":"USD"},
    {"id":"demonstrated_profitability","label":"Demonstrated Profitability","source":"demonstrated_profitability","data_type":"number","unit":"ratio"},
    {"id":"sustainable_growth","label":"Sustainable Growth","source":"sustainable_growth","data_type":"number","unit":"ratio"},
    {"id":"implied_growth","label":"Implied Growth","source":"implied_growth","data_type":"number","unit":"ratio"},
    {"id":"growth_gap_pp","label":"Growth Gap","source":"growth_gap_pp","data_type":"number","unit":"percentage_points"},
    {"id":"implied_profitability","label":"Implied Profitability","source":"implied_profitability","data_type":"number","unit":"ratio"},
    {"id":"profitability_gap_pp","label":"Profitability Gap","source":"profitability_gap_pp","data_type":"number","unit":"percentage_points"},
    {"id":"expectations_gap_score","label":"Expectations Gap Score","source":"expectations_gap_score","data_type":"number","unit":"score"},
    {"id":"data_quality_status","label":"Data Quality","source":"data_quality_status","data_type":"string","unit":null}
  ],
  "ranking": [
    {"column":"expectations_gap_score","direction":"descending"}
  ],
  "logic_env": {
    "market_cap_min": {{ market_cap_min }},
    "market_cap_max": {{ market_cap_max }},
    "liquidity_min_usd": {{ liquidity_min_usd }},
    "avg_volume_days": 200
  },
  "assertions": [
    {"name":"market_cap_bounds_ordered","form":"(and (> market_cap_min 0) (>= market_cap_max market_cap_min))"},
    {"name":"liquidity_threshold_positive","form":"(> liquidity_min_usd 0)"},
    {"name":"average_volume_period","form":"(= avg_volume_days 200)"}
  ]
}
