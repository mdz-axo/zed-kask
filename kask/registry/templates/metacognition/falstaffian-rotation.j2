      "exposed_assumption": "<the framing assumption the shape exposed>",
      "evidence_status": "supported | contested | undetermined"
    }
  ],
  "shapes_applied": ["<shape names>"],
  "framing_errors_detected": [
    {
      "assertion": "<from input>",
      "shape": "<shape name>",
      "error": "<why it is a framing error>",
      "corrected_framing": "<the rotation>"
    }
  ],
