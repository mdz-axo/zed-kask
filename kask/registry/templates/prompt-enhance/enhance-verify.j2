```

## Output

Return JSON only:
```json
{
  "ratings": [
    {"area": "Recall", "rating": "Solid|Partial|Gap", "evidence": "specific observation"},
    {"area": "Mechanism", "rating": "Solid|Partial|Gap", "evidence": "specific observation"},
    {"area": "Rationale", "rating": "Solid|Partial|Gap", "evidence": "specific observation (high tier only)"},
    {"area": "Edge Cases", "rating": "Solid|Partial|Gap", "evidence": "specific observation (high tier only)"},
    {"area": "Synthesis", "rating": "Solid|Partial|Gap", "evidence": "specific observation (high tier only)"}
  ],
  "findings": [
    {"area": "the area", "gap": "what's missing or wrong", "severity": "Prohibition|Guardrail|Guideline", "suggested_fix_direction": "what Phase 3 should address (not the fix itself)"}
  ],
  "acceptance_criteria_check": [
    {"criterion": "the criterion", "met": true, "evidence": "how the prompt satisfies it"}
  ],
  "proxy_eval_simulation": [
    {"input": "the eval input", "would_handle_well": true, "failure_mode": "what would go wrong if false"}
  ],
  "verdict": "pass|rewrite_needed|fail",
  "next_action": "proceed_to_output|rewrite|escalate_to_user",
  "decoupling_attestation": "I am not the generator. I did not write this prompt. I interrogated it independently."
}
```
