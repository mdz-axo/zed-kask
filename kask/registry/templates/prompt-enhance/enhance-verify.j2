- classify
- detect
contract:
  input:
    enhanced_prompt:
      type: string
      description: The Phase 3 rewritten prompt to critique
    original_prompt:
      type: string
    prompt_type:
      type: string
    effort_tier:
      type: string
      enum: [low, medium, high]
    proxy_eval_set:
      type: array
