  "output_path_resolved": {{ output_path_resolved | tojson }},
  "phases_run": {{ phases_run | tojson }},
  "audit_findings": {{ audit_findings | tojson }},
  "grill_ratings": {{ grill_ratings | tojson }},
  "grill_verdict": {{ grill_verdict | tojson }},
  "mutations_applied": {{ mutations_applied | tojson }},
  "mutations_deferred": {{ mutations_deferred | tojson }},
