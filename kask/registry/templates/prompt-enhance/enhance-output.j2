}
```

## Output

Return JSON only:
```json
{
  "delivered_output": "the full formatted output (inline block + change log, or file confirmation, or both)",
  "output_path_written": "path written or empty string",
  "change_log": {
    "summary": "type=X effort=Y grill_verdict=pass convergence=0.0",
    "audit_findings_table": "markdown table",
    "grill_verdict": "pass|rewrite_needed|fail|skipped",
    "grill_ratings": "per-area ratings",
    "mutations_applied": ["list"],
    "deferred_findings": ["list"],
    "residual_risks": ["list"]
  }
}
```
