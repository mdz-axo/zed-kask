- orient
- specify
- sample
- synthesize
contract:
  input:
    prompt:
      type: string
      description: The input prompt to enhance
    effort:
      type: string
      enum:
      - low
      - medium
      - high
      default: medium
      description: Effort tier controlling which phases run and convergence thresholds
    output_format:
      type: string
      enum:
      - inline
      - file
      - both
      default: inline
      description: inline = return in code block (default); file = write to disk; both = inline + file
    output_path:
      type: string
      description: Optional explicit file path for file/both output. If omitted, a default is derived.
    context:
      type: object
      description: Optional context — target model, intended consumer (skill .j2, agent system prompt, chat, infra template), existing eval set if any
  output:
    prompt_type:
      type: string
      enum:
      - coding
      - reasoning
      - creative
      - classification
      - extraction
      - agent-task
      - meta
    effort_tier:
      type: string
      enum:
      - low
      - medium
      - high
    output_format_resolved:
      type: string
      enum:
      - inline
      - file
      - both
    output_path_resolved:
      type: string
    semantic_classification:
      type: object
      description: pragmatic-semantics classification of the prompt's primary claims (IS/OUGHT, epistemic mode, constraint force, provenance)
    proxy_eval_set:
      type: array
      description: 3-5 synthesized representative inputs for medium/high tiers; empty at low tier
    routing:
      type: object
      description: Which phases to run given type + effort (phase: bool map)
    risks:
      type: array
      description: Type-specific risks surfaced for Phase 2 attention
energy_cap: 6144
visibility: Public
