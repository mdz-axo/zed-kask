{
  "enhanced_prompt": "the full rewritten prompt text",
  "unfolded_plan": [
    {"id": "T1", "title": "step or hypothesis title", "d_p_mode": "D|P", "depends_on": [], "reference_model_id": "anchor or zk-ref-open id", "verification_oracle": "check or probe"}
  ],
  "mutations_applied": [
    {"finding": "what was wrong", "mutation": "what was changed", "section": "which section"}
  ],
