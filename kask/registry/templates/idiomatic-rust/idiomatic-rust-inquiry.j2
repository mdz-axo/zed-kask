{# goal: Assess a Rust design problem against the eight design principles, starting from the compiler and clippy diagnostics the caller measured. Interpret each diagnostic through the type-driven lens, identify invariants, invalid states, the ownership graph and the error domain, and cite the diagnostic code behind every compiler-confirmed finding. #}
[inference]
contract:
  input:
    design_problem: string
    existing_code: string
    design_constraints: object
    compiler_facts: object
    iteration_focus: string
  output:
    invariants: array
    invalid_states: array
    ownership_graph: string
