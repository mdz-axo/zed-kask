{# Replica Literary Corpus Generator
   Generates a corpus.yaml for a literary author replica from public-domain
   works (Gutenberg novels, essays, plays) and hand-curated foundational
   rules (critical essays, style manifestos).

   Variables:
     author_slug: string (e.g., "woolf")
     author_name: string (e.g., "Virginia Woolf")
     generation_date: string (ISO date)
     works: [{ title, slug, url, local_path?, format, document_type?, dimensions?, section_types?, mds_categories? }]
     foundational_rules: [{ slug, text, dimensions?, section_type? }]
     entities: optional { characters, places, events, concepts }
     methods: optional [{ name, description }]
     chunking: { min_words: 50, max_words: 200, sentence_boundary: ".!? " }
     validation: { centroid_distance_max: 0.25, exemplar_count_min: 3, exemplar_count_max: 7 }
     budget: { total_passages: 0, triple_budget_per_100: 3750 }
     triple_classifier: string (default: "triple-extractor-literary")
#}
{% extends "replica/corpus-base.j2" %}
{% set replica_class = "literary" %}

{% block ontology %}
# Ontology: GOLEM (Narrative Ontology) — metaphor, analogy, narrative structure,
#                       character development, rhetoric, storytelling devices
#           Dublin Core (dcterms) — bibo:Book, dcterms:creator, dcterms:source
# Tagging: docproc/tag-chunks.j2 applies these ontologies at embed time.
{% endblock %}

{% block budget %}
# Budget: Flat — explicit passage cap and per-100-pages rate.
# total_passages: 0 = no cap (use actual count). triple_budget_per_100: 3750.
budget:
  total_passages: {{ budget.total_passages | default(0) }}
  triple_budget_per_100: {{ budget.triple_budget_per_100 | default(3750) }}
{% endblock %}

{% block foundational_rules %}
# ── Foundational rules (critical essays, style manifestos) ─────────────────
# Embedded as special passages for retrieval. FoundationalRule shape:
# { slug, text, dimensions: [string], section_type: Option<string> }
{% if foundational_rules %}
foundational_rules:
{% for rule in foundational_rules %}
  - slug: {{ rule.slug }}
    text: |-
      {{ rule.text | indent(6) }}
{% if rule.dimensions %}
    dimensions: {{ rule.dimensions | tojson }}
{% endif %}
{% if rule.section_type %}
    section_type: {{ rule.section_type }}
{% endif %}
{% endfor %}
{% else %}
foundational_rules: []
{% endif %}
{% endblock %}

{% block works %}
# ── Corpus sources (Gutenberg public-domain texts) ─────────────────────────
# All works must be public domain (pre-1929 in the US) or CC-licensed.
# Work shape: { title, slug, url, local_path?, format, document_type?, dimensions?, section_types?, mds_categories? }
works:
{% for work in works %}
  - title: "{{ work.title }}"
    slug: {{ work.slug }}
    url: "{{ work.url }}"
{% if work.local_path %}
    local_path: "{{ work.local_path }}"
{% endif %}
    format: {{ work.format | default("text") }}
{% if work.document_type %}
    document_type: {{ work.document_type }}
{% endif %}
{% if work.dimensions %}
    dimensions: {{ work.dimensions | tojson }}
{% endif %}
{% if work.section_types %}
    section_types: {{ work.section_types | tojson }}
{% endif %}
{% if work.mds_categories %}
    mds_categories: {{ work.mds_categories | tojson }}
{% endif %}
{% endfor %}
{% endblock %}

{% block class_specific %}
# Literary replicas use corpus_type: "literary" — activates literary entity
# categories (characters) and literary method signals (parataxis_ratio,
# adjective_density, dialogue_ratio, sentence_length_variance).
corpus_type: "literary"

# Triple extractor classifier for literary passages.
triple_classifier: "{{ triple_classifier | default("triple-extractor-literary") }}"
{% endblock %}
