{# Replica Exemplar/Theme Corpus Generator
   Generates a corpus.yaml for a thematic replica — a literary or mixed-source
   corpus serving a specific domain or theme (e.g., "docs-as-code" for
   gentle-lovelace, "capabilities research" for john-brooks).

   Exemplar replicas carry the full quality-dimension scaffolding
   (dimension_centroids, tag_sets, tag_weights). The budget shape is flexible:
   "absolute" (hard cap, 0 disables triples for style-only), "flat" (passage
   cap + per-100-pages rate), or "per_page" (rate only). Defaults to "absolute".

   Variables:
     author_slug: string (e.g., "john-brooks")
     author_name: string (e.g., "John Brooks")
     generation_date: string (ISO date)
     works: [{ title, slug, url, local_path?, format, document_type?, dimensions?, section_types?, mds_categories? }]
     foundational_rules: [{ slug, text, dimensions?, section_type? }]
     dimension_centroids: [{ name, ref_name, weight, description }]
     tag_sets: [{ name, description, values: [string] }]
     tag_weights: { document_type: { dimension: weight } }
     entities: optional { characters, places, events, concepts }
     methods: optional [{ name, description }]
     chunking: { min_words, max_words, sentence_boundary }
     validation: { centroid_distance_max, exemplar_count_min, exemplar_count_max }
     budget_shape: string ("absolute" | "flat" | "per_page" — default: "absolute")
     budget: { max_triples } | { total_passages, triple_budget_per_100 } | { per_100_pages }
     classifier: string (e.g., "section-classifier")
     triple_classifier: string (e.g., "h_mem-extractor")
     corpus_type: string (default: "literary")
#}
{% extends "replica/corpus-base.j2" %}
{% set replica_class = "exemplar" %}

{% block ontology %}
# Ontology: Dublin Core (dcterms) — document type, subject, source
#           PKO (Procedural Knowledge Ontology) — process/method concepts
#           FIBO (Financial Industry Business Ontology) — if investment/business domain
#           ESO (Epistemic Science Ontology) — if research/epistemic domain
#           GOLEM (Narrative Ontology) — if literary exemplar
# Tagging: docproc/tag-chunks.j2 applies these ontologies at embed time.
# The classifier field below selects which tag-chunks classifier config to use.
{% endblock %}

{% block budget %}
# Budget shape: {{ budget_shape | default("absolute") }}
# Exemplar replicas support all three shapes:
#   absolute: { max_triples } — hard cap; 0 disables triples (style-only).
#   flat: { total_passages, triple_budget_per_100 } — rate with optional passage cap.
#   per_page: { per_100_pages } — rate only (scales with corpus size).
# Effort preset rate: low=2500, medium=3750, high=8100.
{% set shape = budget_shape | default("absolute") %}
{% set b = budget | default({}) %}
{% if shape == "absolute" %}
budget:
  max_triples: {{ b.max_triples | default(0) }}
{% elif shape == "flat" %}
budget:
  total_passages: {{ b.total_passages | default(0) }}
  triple_budget_per_100: {{ b.triple_budget_per_100 | default(default_triple_budget) }}
{% elif shape == "per_page" %}
budget:
  per_100_pages: {{ b.per_100_pages | default(default_triple_budget) }}
{% else %}
budget:
  max_triples: {{ b.max_triples | default(0) }}
{% endif %}
{% endblock %}

{% block foundational_rules %}
# ── Foundational rules (thematic principles, style manifestos) ─────────────
# Embedded as special passages for retrieval. FoundationalRule shape:
# { slug, text, dimensions: [string], section_type: Option<string> }
{% if foundational_rules %}
foundational_rules:
{% for rule in foundational_rules %}
  - slug: {{ rule.slug }}
    text: |-
      {{ rule.text | indent(6) }}
{% if rule.dimensions %}
    dimensions: {{ rule.dimensions | tojson }}
{% endif %}
{% if rule.section_type %}
    section_type: {{ rule.section_type }}
{% endif %}
{% endfor %}
{% else %}
foundational_rules: []
{% endif %}
{% endblock %}

{% block works %}
# ── Corpus sources (mixed: Gutenberg, local corpus, docs, web) ─────────────
# Work shape: { title, slug, url, local_path?, format, document_type?, dimensions?, section_types?, mds_categories? }
works:
{% for work in works %}
  - title: "{{ work.title }}"
    slug: {{ work.slug }}
    url: "{{ work.url }}"
{% if work.local_path %}
    local_path: "{{ work.local_path }}"
{% endif %}
    format: {{ work.format | default("text") }}
{% if work.document_type %}
    document_type: {{ work.document_type }}
{% endif %}
{% if work.dimensions %}
    dimensions: {{ work.dimensions | tojson }}
{% endif %}
{% if work.section_types %}
    section_types: {{ work.section_types | tojson }}
{% endif %}
{% if work.mds_categories %}
    mds_categories: {{ work.mds_categories | tojson }}
{% endif %}
{% endfor %}
{% endblock %}

{% block class_specific %}
# Exemplar replicas use corpus_type: "literary" by default (hybrid — may be
# "academic" if the exemplar is a research persona).
corpus_type: "{{ corpus_type | default("literary") }}"

# ── Dimension centroids (4 quality dimensions) ─────────────────────────────
# DimensionCentroid { name, ref_name, weight, description }
# Weights should sum to 1.0 across all dimensions.
{% if dimension_centroids %}
dimension_centroids:
{% for dc in dimension_centroids %}
  - name: {{ dc.name }}
    ref_name: "{{ dc.ref_name }}"
    weight: {{ dc.weight }}
    description: "{{ dc.description }}"
{% endfor %}
{% else %}
dimension_centroids: []
{% endif %}

# ── Orthogonal tag sets (MDS taxonomy) ─────────────────────────────────────
# TagSet { name, description, values: [string] }
{% if tag_sets %}
tag_sets:
{% for ts in tag_sets %}
  - name: {{ ts.name }}
{% if ts.description %}
    description: "{{ ts.description }}"
{% endif %}
    values: {{ ts.values | tojson }}
{% endfor %}
{% else %}
tag_sets: []
{% endif %}

# ── Tag weighting by document type ─────────────────────────────────────────
# Maps document type → { dimension: weight }. Applied at query time.
{% if tag_weights %}
tag_weights:
{% for doc_type, weights in tag_weights.items() %}
  {{ doc_type }}:
{% for dim, weight in weights.items() %}
    {{ dim }}: {{ weight }}
{% endfor %}
{% endfor %}
{% else %}
tag_weights: {}
{% endif %}

# ── Classifier configuration ───────────────────────────────────────────────
# References registry/classify/{name}.yaml. If empty, section_type defaults
# to "Statement" for all passages.
classifier: "{{ classifier | default("") }}"

# HMem extractor classifier config name. Set to empty string to disable.
triple_classifier: "{{ triple_classifier | default("h_mem-extractor") }}"
{% endblock %}
