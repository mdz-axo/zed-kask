{# Replica Corpus Base Template
   Shared scaffolding for all replica corpus.yaml generators.
   Included by academic-corpus.j2, literary-corpus.j2, exemplar-corpus.j2,
   compound-corpus.j2. Emits the CorpusConfig fields common to all replica classes.

   Contract: kask/crates/hkask-services-corpus/src/embed/types.rs::CorpusConfig
   Every field emitted here MUST exist in CorpusConfig. Unknown fields are
   rejected by #[serde(deny_unknown_fields)] and the parse tests in
   corpus_config_parse_test.rs.

   Ontology annotations appear as structured comments (not YAML fields) so
   they document intent without polluting the data contract. Each class
   template adds its own ontology block via {% block ontology %}.

   Effort/depth/rigor variable:
     effort: string ("low" | "medium" | "high" — default: "medium")
     Controls budget rate, validation thresholds, and exemplar counts.
     Higher effort = more triples stored, stricter validation, more exemplars.
     Explicit values in the context always override effort-derived defaults.

     Effort presets (applied when the context does not provide an explicit value):
       low:    triple_budget_per_100=2500, exemplar_count_min=2,  exemplar_count_max=5,   centroid_distance_max=0.30
       medium: triple_budget_per_100=3750, exemplar_count_min=3,  exemplar_count_max=7,   centroid_distance_max=0.25
       high:   triple_budget_per_100=8100, exemplar_count_min=10, exemplar_count_max=20,  centroid_distance_max=0.15

   Budget shapes (all templates support all three):
     absolute: { max_triples } — hard cap; 0 disables triples (style-only).
     flat:     { total_passages, triple_budget_per_100 } — rate with optional passage cap.
     per_page: { per_100_pages } — rate only (scales with corpus size).
     The shape is selected by budget_shape (default varies by class).

   Variables:
     author_slug: string (e.g., "john-brooks")
     author_name: string (e.g., "John Brooks") — for comments only
     generation_date: string (ISO date)
     replica_class: string ("academic" | "literary" | "exemplar" | "compound")
     effort: string ("low" | "medium" | "high" — default: "medium")
     embedding_model: string (default: "DeepInfra/Qwen/Qwen3-Embedding-0.6B")
     embedding_dim: number (default: 1024)
     batch_size: number (default: 64)
     chunking: { min_words, max_words, sentence_boundary }
     validation: { centroid_distance_max, exemplar_count_min, exemplar_count_max }
     budget_shape: string ("absolute" | "flat" | "per_page")
     budget: { max_triples } | { total_passages, triple_budget_per_100 } | { per_100_pages }
     entities: optional { characters, places, events, concepts } (each: [{name, appears_in}])
     methods: optional [{ name, description }]
#}
# {{ author_name }} Replica Corpus Configuration
# Generated by: replica/{{ replica_class }}-corpus.j2
# Date: {{ generation_date }}
#
# Contract: CorpusConfig (kask/crates/hkask-services-corpus/src/embed/types.rs)
# Validated by: EmbedService::parse_config + #[serde(deny_unknown_fields)]
#
{% block ontology %}{% endblock %}
{# Effort presets: applied when the context does not provide an explicit value.
   Explicit values in validation/budget always override these defaults. #}
{% set effort = effort | default("medium") %}
{% if effort == "low" %}
  {% set default_triple_budget = 2500 %}
  {% set default_exemplar_min = 2 %}
  {% set default_exemplar_max = 5 %}
  {% set default_centroid_max = 0.30 %}
{% elif effort == "high" %}
  {% set default_triple_budget = 8100 %}
  {% set default_exemplar_min = 10 %}
  {% set default_exemplar_max = 20 %}
  {% set default_centroid_max = 0.15 %}
{% else %}
  {% set default_triple_budget = 3750 %}
  {% set default_exemplar_min = 3 %}
  {% set default_exemplar_max = 7 %}
  {% set default_centroid_max = 0.25 %}
{% endif %}
# Effort: {{ effort }} (tunes budget rate, validation thresholds, exemplar counts)
author: {{ author_slug }}

# ── Embedding configuration ────────────────────────────────────────────────
embedding:
  model: "{{ embedding_model | default("DeepInfra/Qwen/Qwen3-Embedding-0.6B") }}"
  dim: {{ embedding_dim | default(1024) }}
  batch_size: {{ batch_size | default(64) }}

# ── Centroid reference (required — top-level, not nested under embedding) ──
centroid_entity_ref: "style:{{ author_slug }}:centroid"

# ── Chunking ───────────────────────────────────────────────────────────────
chunking:
  min_words: {{ (chunking | default({})).min_words | default(50) }}
  max_words: {{ (chunking | default({})).max_words | default(200) }}
  sentence_boundary: "{{ (chunking | default({})).sentence_boundary | default(".!? ") }}"

# ── Validation (all three fields required) ─────────────────────────────────
# Effort-derived defaults are used when the context does not provide explicit values.
# low: centroid_max=0.30, exemplar_min=2, exemplar_max=5
# medium: centroid_max=0.25, exemplar_min=3, exemplar_max=7
# high: centroid_max=0.15, exemplar_min=10, exemplar_max=20
validation:
  centroid_distance_max: {{ (validation | default({})).centroid_distance_max | default(default_centroid_max) }}
  exemplar_count_min: {{ (validation | default({})).exemplar_count_min | default(default_exemplar_min) }}
  exemplar_count_max: {{ (validation | default({})).exemplar_count_max | default(default_exemplar_max) }}

# ── Budget ─────────────────────────────────────────────────────────────────
# All templates support all three shapes: absolute, flat, per_page.
# The shape is selected by budget_shape (default varies by class template).
# Effort presets the triple_budget_per_100 / per_100_pages rate when not explicit:
#   low=2500, medium=3750, high=8100.
{% block budget %}{% endblock %}

# ── Entity declarations (5W1H metadata layer) ──────────────────────────────
# Entity shape: { name: string, appears_in: [work_slug] } (appears_in defaults to [])
{% if entities %}
entities:
{% if entities.characters %}
  characters:
{% for c in entities.characters %}
    - name: "{{ c.name }}"
{% endfor %}
{% else %}
  characters: []
{% endif %}
{% if entities.places %}
  places:
{% for p in entities.places %}
    - name: "{{ p.name }}"
{% endfor %}
{% else %}
  places: []
{% endif %}
{% if entities.events %}
  events:
{% for e in entities.events %}
    - name: "{{ e.name }}"
{% endfor %}
{% else %}
  events: []
{% endif %}
{% if entities.concepts %}
  concepts:
{% for c in entities.concepts %}
    - name: "{{ c.name }}"
{% endfor %}
{% else %}
  concepts: []
{% endif %}
{% else %}
entities:
  characters: []
  places: []
  events: []
  concepts: []
{% endif %}

# ── Declared methods (analytical patterns to detect) ───────────────────────
# DeclaredMethod { name, description, signal: MethodThresholds (all optional),
# threshold: Option<f64> }. Omit `threshold` when not used — do not pass {}.
{% if methods %}
methods:
{% for method in methods %}
  - name: "{{ method.name }}"
    description: "{{ method.description }}"
{% endfor %}
{% else %}
methods: []
{% endif %}

# ── Foundational rules (required — empty list satisfies) ───────────────────
# FoundationalRule { slug, text, dimensions: [string], section_type: Option<string> }
{% block foundational_rules %}{% endblock %}

# ── Works (required — at least one work or empty list) ─────────────────────
{% block works %}{% endblock %}

# ── Replica-class-specific fields ──────────────────────────────────────────
{% block class_specific %}{% endblock %}
