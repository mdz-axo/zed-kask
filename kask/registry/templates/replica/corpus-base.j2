{# Replica Corpus Base Template
   Shared scaffolding for all replica corpus.yaml generators.
   Included by academic-corpus.j2, literary-corpus.j2, exemplar-corpus.j2.
   Emits the CorpusConfig fields common to all replica classes.

   Contract: kask/crates/hkask-services-corpus/src/embed/types.rs::CorpusConfig
   Every field emitted here MUST exist in CorpusConfig. Unknown fields are
   rejected by #[serde(deny_unknown_fields)] and the parse tests in
   corpus_config_parse_test.rs.

   Ontology annotations appear as structured comments (not YAML fields) so
   they document intent without polluting the data contract. Each class
   template adds its own ontology block via {% block ontology %}.

   Variables:
     author_slug: string (e.g., "john-brooks")
     author_name: string (e.g., "John Brooks") — for comments only
     generation_date: string (ISO date)
     replica_class: string ("academic" | "literary" | "exemplar")
     embedding_model: string (default: "DI/Qwen/Qwen3-Embedding-0.6B")
     embedding_dim: number (default: 1024)
     batch_size: number (default: 64)
     chunking: { min_words, max_words, sentence_boundary }
     validation: { centroid_distance_max, exemplar_count_min, exemplar_count_max }
     budget: rendered budget block (emitted by class template — shape varies)
     entities: optional { characters, places, events, concepts } (each: [{name, appears_in}])
     methods: optional [{ name, description }]
#}
# {{ author_name }} Replica Corpus Configuration
# Generated by: replica/{{ replica_class }}-corpus.j2
# Date: {{ generation_date }}
#
# Contract: CorpusConfig (kask/crates/hkask-services-corpus/src/embed/types.rs)
# Validated by: EmbedService::parse_config + #[serde(deny_unknown_fields)]
#
{% block ontology %}{% endblock %}
author: {{ author_slug }}

# ── Embedding configuration ────────────────────────────────────────────────
embedding:
  model: "{{ embedding_model | default("DI/Qwen/Qwen3-Embedding-0.6B") }}"
  dim: {{ embedding_dim | default(1024) }}
  batch_size: {{ batch_size | default(64) }}

# ── Centroid reference (required — top-level, not nested under embedding) ──
centroid_entity_ref: "style:{{ author_slug }}:centroid"

# ── Chunking ───────────────────────────────────────────────────────────────
chunking:
  min_words: {{ chunking.min_words }}
  max_words: {{ chunking.max_words }}
  sentence_boundary: "{{ chunking.sentence_boundary }}"

# ── Validation (all three fields required) ─────────────────────────────────
validation:
  centroid_distance_max: {{ validation.centroid_distance_max }}
  exemplar_count_min: {{ validation.exemplar_count_min }}
  exemplar_count_max: {{ validation.exemplar_count_max }}

# ── Budget ─────────────────────────────────────────────────────────────────
{% block budget %}{% endblock %}

# ── Entity declarations (5W1H metadata layer) ──────────────────────────────
# Entity shape: { name: string, appears_in: [work_slug] } (appears_in defaults to [])
{% if entities %}
entities:
{% if entities.characters %}
  characters:
{% for c in entities.characters %}
    - name: "{{ c.name }}"
{% endfor %}
{% else %}
  characters: []
{% endif %}
{% if entities.places %}
  places:
{% for p in entities.places %}
    - name: "{{ p.name }}"
{% endfor %}
{% else %}
  places: []
{% endif %}
{% if entities.events %}
  events:
{% for e in entities.events %}
    - name: "{{ e.name }}"
{% endfor %}
{% else %}
  events: []
{% endif %}
{% if entities.concepts %}
  concepts:
{% for c in entities.concepts %}
    - name: "{{ c.name }}"
{% endfor %}
{% else %}
  concepts: []
{% endif %}
{% else %}
entities:
  characters: []
  places: []
  events: []
  concepts: []
{% endif %}

# ── Declared methods (analytical patterns to detect) ───────────────────────
# DeclaredMethod { name, description, signal: MethodThresholds (all optional),
# threshold: Option<f64> }. Omit `threshold` when not used — do not pass {}.
{% if methods %}
methods:
{% for method in methods %}
  - name: "{{ method.name }}"
    description: "{{ method.description }}"
{% endfor %}
{% else %}
methods: []
{% endif %}

# ── Foundational rules (required — empty list satisfies) ───────────────────
# FoundationalRule { slug, text, dimensions: [string], section_type: Option<string> }
{% block foundational_rules %}{% endblock %}

# ── Works (required — at least one work or empty list) ─────────────────────
{% block works %}{% endblock %}

# ── Replica-class-specific fields ──────────────────────────────────────────
{% block class_specific %}{% endblock %}
