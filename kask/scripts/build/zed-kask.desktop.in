[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=Text Editor
Comment=A high-performance, multiplayer code editor.
TryExec=$APP_CLI
StartupNotify=$DO_STARTUP_NOTIFY
Exec=$APP_CLI $APP_ARGS
Icon=$APP_ICON
StartupWMClass=$APP_WM_CLASS
Categories=Utility;TextEditor;Development;IDE;
Keywords=zed-kask;
# zed-kask must NOT declare text/plain or application/x-zerosize — those MIME
# types belong to upstream Zed. Declaring them here causes desktop environments
# to show zed-kask as a competitor for opening text files, and the more recently
# installed app can become the default, hijacking the user's real Zed install.
# Only declare the zed-kask-specific URL scheme handler.
MimeType=x-scheme-handler/zed-kask;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec=$APP_CLI --new $APP_ARGS
Name=Open a new workspace