#!/usr/bin/env bash
# Run all kask tests via nextest, separated from upstream Zed tests.
# Usage: ./scripts/test              # run all kask tests
#        ./scripts/test --trace      # run tests + write traces to kask/traces/
#        ./scripts/test --cargo-test # use cargo test instead of nextest
#        ./scripts/test -p hkask-mcp # pass through extra args to nextest
set -euo pipefail

cd "$(dirname "$0")/.."

# All kask workspace packages (crates + mcp-servers + test-harness).
PACKAGES=(
    -p hkask-types -p hkask-capability -p hkask-keystore -p hkask-regulation
    -p hkask-guard -p hkask-forecast -p hkask-lisp -p hkask-templates
    -p hkask-memory -p hkask-mcp -p hkask-mcp-server -p hkask-ledger
    -p hkask-storage -p hkask-inference -p hkask-condenser
    -p hkask-bridge-dublincore -p hkask-services-core -p hkask-email
    -p hkask-media-widget -p hkask-viz-core -p hkask-graph-widget
    -p hkask-test-harness
    -p hkask-mcp-codegraph -p hkask-mcp-companies -p hkask-mcp-condenser
    -p hkask-mcp-corpus -p hkask-mcp-curator -p hkask-mcp-kata-kanban
    -p hkask-mcp-media -p hkask-mcp-research
    -p hkask-mcp-scenarios -p hkask-mcp-swarm -p hkask-mcp-training
)

USE_CARGO_TEST=0
TRACE=0
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --cargo-test)
            USE_CARGO_TEST=1
            shift
            ;;
        --trace)
            TRACE=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [[ "$TRACE" -eq 1 ]]; then
    # Generate a run ID and trace directory.
    RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$(git rev-parse --short HEAD 2>/dev/null || echo nogit)"
    # scripts/test runs from kask/ (cd above), so "traces" resolves to kask/traces/.
    TRACE_DIR="traces/${RUN_ID}"
    mkdir -p "${TRACE_DIR}"

    # Write run manifest.
    cat > "${TRACE_DIR}/manifest.json" <<EOF
{"run_id": "${RUN_ID}", "timestamp": "$(date -u +%FT%TZ)", "packages": [$(printf '"%s,"' "${PACKAGES[@]}" | sed 's/,$//')], "harness_revision": "$(git rev-parse --short HEAD 2>/dev/null || echo nogit)"}
EOF

    # F7: measure wall-clock duration of the test run (cost axis).
    START=$(date +%s)

    if command -v cargo-llvm-cov &>/dev/null && command -v cargo-nextest &>/dev/null && [[ "$USE_CARGO_TEST" -eq 0 ]]; then
        # F2: coverage-instrumented nextest run — single run produces both the
        # nextest JSON event stream (stdout) and an lcov coverage report (file).
        # Avoids double test execution vs running nextest + llvm-cov separately.
        cargo llvm-cov nextest --profile kask "${PACKAGES[@]}" --no-fail-fast \
            --message-format json --lcov --output-path "${TRACE_DIR}/coverage-all.lcov" "$@" \
            2>/dev/null > "${TRACE_DIR}/nextest-output.json" || true
        # Fallback: if the nextest JSON wasn't captured cleanly from the combined
        # run, run a plain nextest pass for the JSON (coverage lcov is already written).
        if [[ ! -s "${TRACE_DIR}/nextest-output.json" ]]; then
            cargo nextest run --profile kask "${PACKAGES[@]}" --no-fail-fast \
                --message-format json "$@" 2>/dev/null > "${TRACE_DIR}/nextest-output.json" || true
        fi
    elif command -v cargo-nextest &>/dev/null && [[ "$USE_CARGO_TEST" -eq 0 ]]; then
        cargo nextest run --profile kask "${PACKAGES[@]}" --no-fail-fast \
            --message-format json "$@" 2>/dev/null > "${TRACE_DIR}/nextest-output.json" || true
    else
        cargo test "${PACKAGES[@]}" -- --format json "$@" > "${TRACE_DIR}/nextest-output.json" 2>/dev/null || true
    fi

    END=$(date +%s)
    COST_TOKENS=$((END - START))

    # Compute simple metrics from the nextest JSON output.
    TOTAL=$(grep -c '"type":"test"' "${TRACE_DIR}/nextest-output.json" 2>/dev/null || echo 0)
    PASSED=$(grep -c '"event":"finished"' "${TRACE_DIR}/nextest-output.json" 2>/dev/null || echo 0)

    # F2: Coverage percentage and per-crate split from the lcov report.
    COVERAGE_PCT=""
    COVERAGE_BY_CRATE_JSON=""
    if [[ -f "${TRACE_DIR}/coverage-all.lcov" ]]; then
        TOTAL_LINES=$(grep '^LF:' "${TRACE_DIR}/coverage-all.lcov" | cut -d: -f2 | paste -sd+ | bc 2>/dev/null || echo 0)
        HIT_LINES=$(grep '^LH:' "${TRACE_DIR}/coverage-all.lcov" | cut -d: -f2 | paste -sd+ | bc 2>/dev/null || echo 0)
        if [[ "$TOTAL_LINES" -gt 0 ]] 2>/dev/null; then
            COVERAGE_PCT=$(echo "scale=4; $HIT_LINES / $TOTAL_LINES" | bc 2>/dev/null || echo 0)
        fi

        # Split the combined lcov into per-crate files at coverage/<crate>.lcov.
        # Each SF: line contains the source path; group by the crate directory name
        # (the segment after "crates/" in the path).
        COVERAGE_DIR="${TRACE_DIR}/coverage"
        mkdir -p "$COVERAGE_DIR"
        awk -v outdir="$COVERAGE_DIR" '
            /^SF:/ {
                path = substr($0, 4)
                crate = "other"
                n = split(path, parts, "/")
                for (i = 1; i <= n; i++) {
                    if (parts[i] == "crates" && i < n) {
                        crate = parts[i+1]
                        break
                    }
                }
                outfile = outdir "/" crate ".lcov"
            }
            {
                if (outfile != "") print $0 >> outfile
            }
            /^LF:/ { lf[crate] += substr($0, 4) }
            /^LH:/ { lh[crate] += substr($0, 4) }
            END {
                totalsfile = outdir "/.crate-totals"
                for (c in lf) {
                    printf "%s\t%d\t%d\n", c, lh[c]+0, lf[c]+0 > totalsfile
                }
            }
        ' "${TRACE_DIR}/coverage-all.lcov" 2>/dev/null || true

        # Build coverage_by_crate JSON from the per-crate totals.
        if [[ -f "${COVERAGE_DIR}/.crate-totals" ]] && command -v jq &>/dev/null; then
            COVERAGE_BY_CRATE_JSON=$(jq -R -s '
                split("\n") | map(select(length > 0) | split("\t")) |
                reduce .[] as [$crate, $lh, $lf] ({};
                    .[$crate] = (if ($lf | tonumber) > 0 then (($lh | tonumber) / ($lf | tonumber)) else 0 end)
                )
            ' "${COVERAGE_DIR}/.crate-totals" 2>/dev/null || echo "")
        fi
    fi

    # Write metrics.json — coverage_pct and coverage_by_crate are included only
    # when available. When absent, the stability gate's metric_present check
    # treats them as "no signal" (not zero), preventing spurious convergence
    # (design §9.5 #5). cost_tokens is always present (F7 cost axis).
    METRICS_FILE="${TRACE_DIR}/metrics.json"
    if command -v jq &>/dev/null; then
        jq -n \
            --argjson pass_rate "$PASSED" \
            --argjson total_tests "$TOTAL" \
            --arg run_id "$RUN_ID" \
            --argjson cost_tokens "$COST_TOKENS" \
            '{pass_rate: $pass_rate, total_tests: $total_tests, run_id: $run_id, cost_tokens: $cost_tokens}' \
            > "$METRICS_FILE"
        if [[ -n "$COVERAGE_PCT" ]]; then
            tmp_metrics=$(mktemp)
            if jq --argjson cp "$COVERAGE_PCT" '. + {coverage_pct: $cp}' \
                "$METRICS_FILE" > "$tmp_metrics" 2>/dev/null; then
                mv "$tmp_metrics" "$METRICS_FILE"
            else
                rm -f "$tmp_metrics"
            fi
        fi
        if [[ -n "$COVERAGE_BY_CRATE_JSON" ]]; then
            tmp_metrics=$(mktemp)
            if jq --argjson cbc "$COVERAGE_BY_CRATE_JSON" '. + {coverage_by_crate: $cbc}' \
                "$METRICS_FILE" > "$tmp_metrics" 2>/dev/null; then
                mv "$tmp_metrics" "$METRICS_FILE"
            else
                rm -f "$tmp_metrics"
            fi
        fi
    else
        # No jq — write what we can manually (coverage_by_crate skipped).
        if [[ -n "$COVERAGE_PCT" ]]; then
            cat > "$METRICS_FILE" <<EOF
{"pass_rate": ${PASSED}, "total_tests": ${TOTAL}, "run_id": "${RUN_ID}", "cost_tokens": ${COST_TOKENS}, "coverage_pct": ${COVERAGE_PCT}}
EOF
        else
            cat > "$METRICS_FILE" <<EOF
{"pass_rate": ${PASSED}, "total_tests": ${TOTAL}, "run_id": "${RUN_ID}", "cost_tokens": ${COST_TOKENS}}
EOF
        fi
    fi

    echo "Traces written to ${TRACE_DIR}"
elif command -v cargo-nextest &>/dev/null && [[ "$USE_CARGO_TEST" -eq 0 ]]; then
    exec cargo nextest run --profile kask "${PACKAGES[@]}" --no-fail-fast "$@"
else
    exec cargo test "${PACKAGES[@]}" "$@"
fi