# =============================================================================
# zed-kask — API Keys Template
# =============================================================================
# Copy this file to .env and fill in your API keys:
#   cp kask/.env.example kask/.env
#
# This file contains ONLY API keys. All other configuration (model names,
# provider defaults, fusion settings, guard limits, etc.) is built into the
# zed-kask code as sensible defaults. You can override any setting later via
# environment variables or the "kask" section in settings.json.
#
# To get started: fill in the API keys for the providers you have accounts
# with. At least ONE inference provider key is required.
# =============================================================================

# ─── Inference Provider API Keys ────────────────────────────────────────────
# At least ONE required. Provider syntax: provider_id/model (e.g. OpenRouter/z-ai/glm-5.2)
# OpenRouter is the default provider — recommended to start with.
# Get a key: https://openrouter.ai/keys

OPENROUTER_API_KEY=

# DeepInfra — $1.30/month free credits | https://deepinfra.com/
DEEPINFRA_API_KEY=

# Together AI — $5 free credits | https://together.ai/
TOGETHERAI_API_KEY=

# fal.ai — pay-per-use, generous free tier | https://fal.ai/
FALAI_API_KEY=

# KiloCode — unified API for 200+ models plus tools | https://kilo.ai/
KILOCODE_API_KEY=

# Cline — open source unified API for models and tools | https://cline.bot/
CLINE_API_KEY=


# ─── Web Search Provider API Keys (optional) ────────────────────────────────
# At least ONE recommended for research tools.

# Brave Search API — free tier: 2,000 queries/month | https://brave.com/search/api/
HKASK_BRAVE_API_KEY=

# Firecrawl — web scraping + search | https://firecrawl.dev/
HKASK_FIRECRAWL_API_KEY=

# Tavily — AI-optimized search | https://tavily.com/
HKASK_TAVILY_API_KEY=

# SerpAPI — Google Search API | https://serpapi.com/
HKASK_SERPAPI_API_KEY=

# Exa — semantic search | https://exa.ai/
HKASK_EXA_API_KEY=
HKASK_EXA_TEAM_ID=

# Browserbase — headless browser for web browsing | https://browserbase.com/
HKASK_BROWSERBASE_API_KEY=
HKASK_BROWSERBASE_PROJECT_ID=


# ─── Financial Data Provider API Keys (optional) ───────────────────────────

# Financial Modeling Prep — US company data | https://financialmodelingprep.com/
HKASK_FMP_API_KEY=

# EOD Historical Data — global markets data | https://eodhd.com/
HKASK_EODHD_API_KEY=


# ─── Cloud Infrastructure API Keys (optional) ──────────────────────────────

# RunPod — GPU cloud for inference + training | https://runpod.io/
RUNPOD_API_KEY=
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET=

# HuggingFace — model/adapter repository access | https://huggingface.co/
HF_TOKEN=

# Nebius AI Cloud — GPU VMs for training | https://nebius.com/
NEBIUS_PROJECT_ID=
NEBIUS_SUBNET_ID=



# ─── Cloud Provider API Tokens (optional) ──────────────────────────────────

# Hetzner Cloud — cost leader for self-managed K3s | https://docs.hetzner.cloud/
HCLOUD_TOKEN=

# Akamai Cloud (formerly Linode) | https://cloud.linode.com/profile/tokens
LINODE_TOKEN=


# ─── Container Registry (optional) ─────────────────────────────────────────

DOCKER_HUB_USERNAME=
DOCKER_HUB_TOKEN=


# ─── Email / SMTP (optional) ───────────────────────────────────────────────
# For Curator email notifications. Uncomment and fill in if needed.

# HKASK_SMTP_HOST=
# HKASK_SMTP_PORT=465
# HKASK_SMTP_USERNAME=
# HKASK_SMTP_PASSWORD=
# HKASK_DOMAIN=
# HKASK_CURATOR_EMAIL=
