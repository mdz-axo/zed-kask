#!/usr/bin/env bash
# pre-commit — scoped tree-shape invariant gates at the introducing commit.
#
# Composition with kask/githooks/pre-push (2026-10-30): pre-push remains
# the full release gate — every gate still runs there before exposure.
# This hook moves the CHEAP tree-shape gates to the commit that can
# introduce their drift, so the failure surfaces while the author still
# has context, instead of at push time with N commits stacked on the
# drift (observed 4x in 2026-10: README doc-count anchor drift 3x, a
# missing frontmatter header, the kata-kanban pin-site line drift — each
# blocked a push and needed a hand-written reconciliation commit).
#
# Scoping: a gate runs only when the commit STAGES a file on that gate's
# watched surface, so unrelated commits pay ~nothing and cross-stream
# friction stays proportional (a commit touching only crates/ code runs
# no docs gates).
#
# Like pre-push, the gates read the working tree: another stream's
# uncommitted drift can surface here — the gate output names its exact
# finding, and the same drift would block the operator's push later
# anyway; this only moves the discovery earlier, to the stream that
# introduced it. --no-verify is the explicit bypass.
#
# Self-test: kask/scripts/check-pre-commit-selftest.sh (runs in CI via
# the gate-selftest glob).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

staged="$(git diff --cached --name-only)"
[ -z "$staged" ] && exit 0

GATES_DIR="$REPO_ROOT/kask/scripts"
failures=()

scope_gate() { # scope_gate <name> <script> <watched-glob...> — run the
  # gate iff the staged set touches its watched surface.
  local name="$1" script="$2"; shift 2
  local pat path hit=""
  for pat in "$@"; do
    while IFS= read -r path; do
      [ -z "$path" ] && continue
      # shellcheck disable=SC2254
      case "$path" in
        $pat) hit=1; break ;;
      esac
    done <<<"$staged"
    [ -n "$hit" ] && break
  done
  [ -z "$hit" ] && return 0
  if [ ! -f "$script" ]; then
    echo "[pre-commit] warning: gate script not found at $script — unchecked on this commit (pre-push remains the backstop)" >&2
    return 0
  fi
  local out
  if ! out="$(bash "$script" 2>&1)"; then
    failures+=("$name")
    printf '%s\n' "$out" >&2
  fi
  return 0
}

# The five cheap tree-shape gates, each scoped to its watched surface.
scope_gate "diagram-registry-parity" "$GATES_DIR/check-diagram-registry-parity.sh" \
  'kask/docs/*'
scope_gate "docs-count-gate" "$GATES_DIR/check-docs-count-gate.sh" \
  'kask/docs/*'
scope_gate "skill-crossrefs" "$GATES_DIR/check-skill-crossrefs.sh" \
  '.agents/skills/*' 'kask/registry/*' 'crates/agent_skills/*'
scope_gate "docs-frontmatter" "$GATES_DIR/check-docs-frontmatter.sh" \
  'kask/docs/*'
scope_gate "mcp-readme-counts" "$GATES_DIR/check-mcp-readme-counts.sh" \
  'kask/docs/reference/mcp-servers/*' 'kask/mcp-servers/*' 'kask/scripts/build/mcp-servers.txt'

if [ "${#failures[@]}" -gt 0 ]; then
  echo "pre-commit: rejected — tree-shape gate(s) red: ${failures[*]}" >&2
  echo "Fix the gate's findings above in this commit, or re-commit with" >&2
  echo "--no-verify as an explicit choice (pre-push still runs the full set)." >&2
  exit 1
fi
exit 0