#!/usr/bin/env bash
# pre-push — net-lines + DIVERGENCE.md seam reporting for the pushed
# range, plus the one blocking code-quality gate (rustfmt), run against
# the PUSHED COMMIT via a git archive export.
#
# 2026-10-31 operator mandate: the documentation/process bookkeeping
# gate set (docs-count, docs-frontmatter, docs-citations and its
# anchors/drift siblings, diagram-registry-parity, mcp-readme-counts,
# skill-crossrefs and its siblings, retired-record, goal-traceability)
# is unwired from push and CI enforcement. Those scripts remain on disk
# as advisory agent tools — run voluntarily by the streams that want
# them; nothing may block a push or redden CI on them again. The wiring
# that carried them is deleted in the same change, along with
# kask/githooks/pre-commit (its five scoped gates were all in the
# unwired class).
#
# What blocks a push, now and deliberately, is exactly one thing:
# rustfmt drift in the pushed commits — the same check CI runs, so a
# red push never becomes a wasted red CI run. It runs inside the
# export (cargo fmt needs no .git, verified 2026-10-31), so a busy
# working tree can neither block nor redden a push: a push of sha S
# is gated on exactly S's content. --no-verify remains the explicit
# bypass.
#
# stdin (git pre-push protocol), one line per ref being pushed:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# The all-zero sha marks a creation (no remote counterpart) or a
# deletion.
#
# Output per pushed ref:
#   [pre-push] <ref>: <git diff --shortstat> — net <±N> lines
#   [pre-push] seams: +<A> added / -<R> retired (DIVERGENCE.md '^| D<digits>' rows) — net <±S>
#
# Self-test: kask/scripts/check-pre-push-selftest.sh (runs in CI via the
# gate-selftest glob).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

ZERO=0000000000000000000000000000000000000000

# Stash the pushed refs first: the reporting loop below needs every line.
ref_lines=()
while read -r local_ref local_sha remote_ref remote_sha; do
  ref_lines+=("$local_ref $local_sha $remote_ref $remote_sha")
done
[ "${#ref_lines[@]}" -eq 0 ] && exit 0 # nothing pushed: nothing to gate

# ── The rustfmt gate, over the PUSHED COMMIT ───────────────────────────────
gate_failures=()

run_gate() { # run_gate <name> <script> <gate-root> — records failures, never aborts
  local name="$1" script="$2" gate_root="$3"
  if [ ! -f "$script" ]; then
    echo "[pre-push] warning: gate script not present in the gated object ($name — $script) — unchecked on this push (CI remains the backstop)" >&2
    return 0
  fi
  local out
  if ! out="$(cd "$gate_root" && REPO_ROOT="$gate_root" bash "$script" 2>&1)"; then
    gate_failures+=("$name")
    printf '%s\n' "$out" >&2
  fi
  return 0
}

EXPORT_DIR=""
cleanup() { [ -n "$EXPORT_DIR" ] && rm -rf "$EXPORT_DIR"; }
trap cleanup EXIT

gated=""
for line in "${ref_lines[@]}"; do
  read -r local_ref local_sha remote_ref remote_sha <<<"$line"
  [ "$local_sha" = "$ZERO" ] && continue # a deletion ships nothing to attest
  case " $gated " in *" $local_sha "*) continue ;; esac # gate each sha once
  gated="$gated $local_sha"

  EXPORT_DIR="$(mktemp -d)"
  if ! git archive "$local_sha" | tar -x -C "$EXPORT_DIR" 2>/dev/null; then
    echo "pre-push: cannot export $local_sha ($local_ref) for gating — refusing to attest what cannot be read" >&2
    exit 1
  fi

  run_gate "rustfmt" "$EXPORT_DIR/kask/scripts/check-rustfmt.sh" "$EXPORT_DIR"

  rm -rf "$EXPORT_DIR"
  EXPORT_DIR=""
done

if [ "${#gate_failures[@]}" -gt 0 ]; then
  echo "pre-push: rejected — invariant gate(s) red: ${gate_failures[*]}" >&2
  echo "Each gate's findings are printed above (its output precedes this line)." >&2
  echo "The gates read the PUSHED COMMIT, not the working tree — in-flight work" >&2
  echo "in the tree is not the cause; fix the pushed commits, or push with" >&2
  echo "--no-verify as an explicit operator choice." >&2
  exit 1
fi

# ── Net-lines/seam reporting (advisory — never blocks) ─────────────────────
for line in "${ref_lines[@]}"; do
  read -r local_ref local_sha remote_ref remote_sha <<<"$line"
  [ "$local_sha" = "$ZERO" ] && continue # ref deletion: nothing to measure

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: no remote counterpart. Fall back to the upstream merge
    # base so the number still means "what the fork adds"; if that is
    # unavailable too, say so and skip — never guess a range.
    base="$(git merge-base upstream/main "$local_sha" 2>/dev/null)"
    if [ -z "$base" ]; then
      echo "[pre-push] $local_ref: new branch, no upstream/main merge base — net-lines skipped"
      continue
    fi
    range="$base..$local_sha"
    note=" (new branch, vs upstream merge base)"
  else
    range="$remote_sha..$local_sha"
    note=""
  fi

  shortstat="$(git diff --shortstat "$range" 2>/dev/null)"
  if [ -n "$shortstat" ]; then
    net="$(git diff --numstat "$range" 2>/dev/null | awk '{a += $1; d += $2} END {printf "%+d", a - d}')"
    echo "[pre-push] $local_ref$note: $shortstat — net $net lines"
  else
    echo "[pre-push] $local_ref$note: no diff in range"
  fi

  seam_added="$(git diff "$range" -- DIVERGENCE.md 2>/dev/null | grep -c '^+| D[0-9]')"
  seam_retired="$(git diff "$range" -- DIVERGENCE.md 2>/dev/null | grep -c '^-| D[0-9]')"
  echo "[pre-push] seams: +$seam_added added / -$seam_retired retired (DIVERGENCE.md '^| D<digits>' rows) — net $((seam_added - seam_retired))"
done

exit 0