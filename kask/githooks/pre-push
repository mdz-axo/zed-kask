#!/usr/bin/env bash
# pre-push — net-lines + DIVERGENCE.md seam reporting for the pushed
# range, plus eight blocking gates (four code-hygiene, three citation,
# rustfmt), run against the PUSHED COMMIT via a git archive export.
#
# 2026-10-31 operator mandate: the documentation/process bookkeeping
# gate set (docs-count, docs-frontmatter, docs-citations and its
# anchors/drift siblings, diagram-registry-parity, mcp-readme-counts,
# skill-crossrefs and its siblings, retired-record, goal-traceability)
# is unwired from push and CI enforcement. Those scripts remain on disk
# as advisory agent tools — run voluntarily by the streams that want
# them; nothing may block a push or redden CI on them again. The wiring
# that carried them is deleted in the same change, along with
# kask/githooks/pre-commit (its five scoped gates were all in the
# unwired class).
#
# 2026-11-02 operator decision (T3 of the 2026-11-01 refactor-alignment
# continuation, “complete T3”): the THREE CITATION GATES are re-wired —
# check-docs-citations.sh, check-docs-citation-drift.sh and
# check-code-docs-citations.sh run below against the pushed commit's
# export. The rest of the 2026-10-31 unwired set stays unwired. The
# citation gates gained export mode for this (REPO_ROOT honored, find
# fallback for ls-files, history-dependent warn tiers degrade with a
# surfaced note) — the evidence: the kanban specimen (live tool
# descriptions citing a deleted doc for two days) and the false-clean
# instrument lessons of 2026-11-01/02. Drift baseline discipline: the
# drift gate's --refresh pins the audit hash after a deep audit or
# re-anchoring pass, and the refreshed baseline is committed with the
# change that earned it — never refreshed casually.
#
# Retired outright 2026-11-01 (operator approval): goal-traceability and
# its selftest — warn-only, the weakest signal in the set; the commit-msg
# hook's advisory invocation and the kask-invariants selftest-loop skip
# entry went with them.
#
# What blocks a push, now and deliberately, is eight things, every one
# mirroring a CI check-job step: rustfmt drift, the three citation gates
# (docs citations, citation drift, code->docs citations), and — by the
# 2026-11-11 operator decision — unsafe-forbid, version-sync,
# provider-profiles and structural-traps. The evidence for the four
# additions: 27 of the 30 Kask-invariants runs on main before that date
# were red, none of them on a step this hook gated, so the hook's stated
# purpose (a red push never becomes a wasted red CI run) was not being
# served; structural-traps alone reddened 11 of the 30. The four cost
# about 2s together. The other frequent CI failures (the duplication
# ratchet, cargo test) stay CI-only: minutes-tier, or needing a network
# fetch. Each gate prints one progress line with its elapsed time, so a
# slow run is legible as progress rather than a hang (the 2026-11-11
# push sat silent for 98 minutes across a suspend and a throttled CPU).
# 2026-11-04
# operator ratification: the citation-gates CI step (kask-invariants.yml)
# runs the same three gates over the real checkout, blocking tier only —
# warnings log, never redden, honoring the 2026-10-31 mandate's substance
# while superseding its letter; --refresh never runs in CI, the audit
# point is operator-earned. The hook remains the point-of-change
# enforcement over the exact pushed sha; CI is the shared-record
# backstop, and its selftest glob still keeps every gate from silently
# going vacuous. Each runs
# inside the export (cargo fmt needs no .git, verified 2026-10-31;
# the citation gates' export mode verified 2026-11-02), so a busy
# working tree can neither block nor redden a push: a push of sha S
# is gated on exactly S's content. --no-verify remains the explicit
# bypass.
#
# stdin (git pre-push protocol), one line per ref being pushed:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# The all-zero sha marks a creation (no remote counterpart) or a
# deletion.
#
# Output per pushed ref:
#   [pre-push] <ref>: <git diff --shortstat> — net <±N> lines
#   [pre-push] seams: +<A> added / -<R> retired (DIVERGENCE.md '^| D<digits>' rows) — net <±S>
#
# Self-test: kask/scripts/check-pre-push-selftest.sh (runs in CI via the
# gate-selftest glob).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

ZERO=0000000000000000000000000000000000000000

# Stash the pushed refs first: the reporting loop below needs every line.
ref_lines=()
while read -r local_ref local_sha remote_ref remote_sha; do
  ref_lines+=("$local_ref $local_sha $remote_ref $remote_sha")
done
[ "${#ref_lines[@]}" -eq 0 ] && exit 0 # nothing pushed: nothing to gate

# ── The blocking gates, over the PUSHED COMMIT ─────────────────────────────
gate_failures=()

now_us() { # microseconds; bash < 5 has no EPOCHREALTIME and falls back to whole seconds
  local t="${EPOCHREALTIME:-$SECONDS.000000}"
  printf '%s' "${t/[.,]/}"
}

# run_gate <name> <script> <gate-root> [<export-marker>] — records
# failures, never aborts. <export-marker> is a string the gate script must
# contain to be runnable inside an export: a pushed commit that predates a
# gate's export support carries a script that cannot run without .git, and
# running it would block the push on a tooling error rather than a finding.
run_gate() {
  local name="$1" script="$2" gate_root="$3" marker="${4:-}"
  if [ ! -f "$script" ]; then
    echo "[pre-push] warning: gate script not present in the gated object ($name — $script) — unchecked on this push (CI remains the backstop)" >&2
    return 0
  fi
  if [ -n "$marker" ] && ! grep -qF -- "$marker" "$script"; then
    echo "[pre-push] warning: the gated object's $name script predates export gating — unchecked on this push (CI remains the backstop)" >&2
    return 0
  fi
  local out t0 ms verdict=ok
  t0="$(now_us)"
  printf '[pre-push] %s … ' "$name" >&2
  if ! out="$(cd "$gate_root" && REPO_ROOT="$gate_root" bash "$script" 2>&1)"; then
    verdict=RED
    gate_failures+=("$name")
  fi
  ms=$(( ($(now_us) - t0) / 1000 ))
  printf '%s (%d.%ds)\n' "$verdict" $((ms / 1000)) $(((ms % 1000) / 100)) >&2
  [ "$verdict" = ok ] || printf '%s\n' "$out" >&2
  return 0
}

EXPORT_DIR=""
cleanup() { [ -n "$EXPORT_DIR" ] && rm -rf "$EXPORT_DIR"; }
trap cleanup EXIT

gated=""
for line in "${ref_lines[@]}"; do
  read -r local_ref local_sha remote_ref remote_sha <<<"$line"
  [ "$local_sha" = "$ZERO" ] && continue # a deletion ships nothing to attest
  case " $gated " in *" $local_sha "*) continue ;; esac # gate each sha once
  gated="$gated $local_sha"

  EXPORT_DIR="$(mktemp -d)"
  if ! git archive "$local_sha" | tar -x -C "$EXPORT_DIR" 2>/dev/null; then
    echo "pre-push: cannot export $local_sha ($local_ref) for gating — refusing to attest what cannot be read" >&2
    exit 1
  fi

  echo "[pre-push] gating ${local_sha:0:10} ($local_ref) over an export of the pushed commit" >&2
  # Cheapest first, so the fast verdicts arrive before the slow ones.
  run_gate "unsafe-forbid" "$EXPORT_DIR/kask/scripts/check-unsafe-forbid.sh" "$EXPORT_DIR"
  run_gate "version-sync" "$EXPORT_DIR/kask/scripts/check-version-sync.sh" "$EXPORT_DIR"
  run_gate "provider-profiles" "$EXPORT_DIR/kask/scripts/check-provider-profiles.sh" "$EXPORT_DIR"
  run_gate "structural-traps" "$EXPORT_DIR/kask/scripts/check-structural-traps.sh" "$EXPORT_DIR" 'REPO_ROOT:-'
  run_gate "code-docs-citations" "$EXPORT_DIR/kask/scripts/check-code-docs-citations.sh" "$EXPORT_DIR"
  run_gate "docs-citations" "$EXPORT_DIR/kask/scripts/check-docs-citations.sh" "$EXPORT_DIR"
  run_gate "citation-drift" "$EXPORT_DIR/kask/scripts/check-docs-citation-drift.sh" "$EXPORT_DIR"
  run_gate "rustfmt" "$EXPORT_DIR/kask/scripts/check-rustfmt.sh" "$EXPORT_DIR"

  rm -rf "$EXPORT_DIR"
  EXPORT_DIR=""
done

if [ "${#gate_failures[@]}" -gt 0 ]; then
  echo "pre-push: rejected — invariant gate(s) red: ${gate_failures[*]}" >&2
  echo "Each gate's findings are printed above (its output precedes this line)." >&2
  echo "The gates read the PUSHED COMMIT, not the working tree — in-flight work" >&2
  echo "in the tree is not the cause; fix the pushed commits, or push with" >&2
  echo "--no-verify as an explicit operator choice." >&2
  exit 1
fi

# ── Net-lines/seam reporting (advisory — never blocks) ─────────────────────
for line in "${ref_lines[@]}"; do
  read -r local_ref local_sha remote_ref remote_sha <<<"$line"
  [ "$local_sha" = "$ZERO" ] && continue # ref deletion: nothing to measure

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: no remote counterpart. Fall back to the upstream merge
    # base so the number still means "what the fork adds"; if that is
    # unavailable too, say so and skip — never guess a range.
    base="$(git merge-base upstream/main "$local_sha" 2>/dev/null)"
    if [ -z "$base" ]; then
      echo "[pre-push] $local_ref: new branch, no upstream/main merge base — net-lines skipped"
      continue
    fi
    range="$base..$local_sha"
    note=" (new branch, vs upstream merge base)"
  else
    range="$remote_sha..$local_sha"
    note=""
  fi

  shortstat="$(git diff --shortstat "$range" 2>/dev/null)"
  if [ -n "$shortstat" ]; then
    net="$(git diff --numstat "$range" 2>/dev/null | awk '{a += $1; d += $2} END {printf "%+d", a - d}')"
    echo "[pre-push] $local_ref$note: $shortstat — net $net lines"
  else
    echo "[pre-push] $local_ref$note: no diff in range"
  fi

  seam_added="$(git diff "$range" -- DIVERGENCE.md 2>/dev/null | grep -c '^+| D[0-9]')"
  seam_retired="$(git diff "$range" -- DIVERGENCE.md 2>/dev/null | grep -c '^-| D[0-9]')"
  echo "[pre-push] seams: +$seam_added added / -$seam_retired retired (DIVERGENCE.md '^| D<digits>' rows) — net $((seam_added - seam_retired))"
done

exit 0